 const processPanels = (html, index) => {
 	const tree = htmlToHast(html, { fragment: true });
+	// satteri puts what a <template> holds in `children`, and toHtml writes
+	// only `content`, so a declarative shadow root came out empty. The
+	// templates are collected first, so one inside another is moved too.
+	const templates = [];
+	visit(tree, "element", (node) => {
+		if (node.tagName === "template" && !node.content) templates.push(node);
+	});
