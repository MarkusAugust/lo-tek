---
import Preview from "./Preview.astro"
---

<Preview id="demo-date" styles={["field", "button", "paragraph"]} maxWidth="26rem" layout="column">
	<lt-field>
		<label class="lt-label" for="demo-deliver-by">Deliver by</label>
		<input
			class="lt-input"
			data-variant="date"
			id="demo-deliver-by"
			name="deliver-by"
			type="date"
			min="2079-01-01"
			max="2079-12-31"
		/>
		<p class="lt-help-text">Type the date as 31/05/2079, or pick it in the calendar.</p>
	</lt-field>

	<p class="lt-paragraph" id="demo-date-answer">No date set. The board waits.</p>
</Preview>

<script>
	import { defineLtField } from "@lo-tek/interfaces/field"

	defineLtField()

	// The preview sits in a shadow root, so we go through the host element.
	const surface = document.getElementById("demo-date")?.shadowRoot
	const field = surface?.getElementById("demo-deliver-by") as HTMLInputElement | null
	const answer = surface?.getElementById("demo-date-answer")

	field?.addEventListener("change", () => {
		if (!answer) return
		answer.textContent = field.value
			? `The server receives ${field.value}, whatever the date looks like in the field.`
			: "No date set. The board waits."
	})
</script>
