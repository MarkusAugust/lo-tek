---
import Preview from "./Preview.astro"
---

<Preview
	id="demo-list"
	styles={[
		"search",
		"tag",
		"table",
		"skeleton",
		"alert",
		"button",
		"label",
		"sr-only",
		"heading",
		"paragraph",
	]}
	layout="stack"
	maxWidth="34rem"
	extraCss={`
		/* The layout is the app's, not the system's: LO-TEK provides the
		   search field, the tags and the table, while the space between them
		   belongs to the page that puts them together. */
		#demo-list-root {
			display: flex;
			flex-direction: column;
			gap: var(--lt-spacing-5);
		}

		.demo-filters {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--lt-spacing-2);
		}

		.demo-filters h3 {
			flex-basis: 100%;
			margin: 0 0 var(--lt-spacing-1);
		}

		#demo-reload {
			align-self: start;
		}
	`}
>
	<div id="demo-list-root">
		<form role="search" class="lt-search-row" id="demo-search-form">
			<label class="lt-label lt-sr-only" for="demo-search">Search floors</label>
			<input
				class="lt-input lt-search"
				type="search"
				id="demo-search"
				name="q"
				placeholder="Search floors"
			/>
		</form>

		<div role="group" aria-labelledby="demo-filters" class="demo-filters">
			<h3 class="lt-heading" data-size="xs" id="demo-filters">Status</h3>
			<button class="lt-tag" data-selectable aria-pressed="false" type="button" data-status="Dry">Dry</button>
			<button class="lt-tag" data-selectable aria-pressed="false" type="button" data-status="Damp">Damp</button>
			<button class="lt-tag" data-selectable aria-pressed="false" type="button" data-status="Seasonal">Seasonal</button>
		</div>

		<p class="lt-sr-only" role="status" id="demo-matches"></p>

		<div id="demo-result"></div>

		<button class="lt-button" data-variant="secondary" type="button" id="demo-reload">
			Reload the list
		</button>
	</div>
</Preview>

<script>
	type Floor = {
		floor: number
		height: number
		rent: string
		status: string
	}

	const FLOORS: Floor[] = [
		{ floor: 14, height: 6, rent: "EB 4,200", status: "Dry" },
		{ floor: 22, height: 31, rent: "EB 9,800", status: "Dry" },
		{ floor: 12, height: 2, rent: "EB 2,600", status: "Damp" },
		{ floor: 9, height: 1, rent: "EB 1,100", status: "Seasonal" },
	]

	/*
	 * The sorting is the demo's, not the system's. LO-TEK provides the button
	 * and the arrow, and reads the direction from `aria-sort`. Which column is
	 * sorted is known only here, and is written out as `aria-sort` on one
	 * header.
	 */
	type Column = "floor" | "height"
	type Direction = "ascending" | "descending"
	let sorting: { column: Column; direction: Direction } = {
		column: "height",
		direction: "descending",
	}
	let shown: Floor[] = []

	function sorted(floors: Floor[]): Floor[] {
		const { column, direction } = sorting
		const sign = direction === "ascending" ? 1 : -1
		return [...floors].sort((a, b) => sign * (a[column] - b[column]))
	}

	function header(column: Column, text: string): string {
		const isSorted = sorting.column === column
		return `<th scope="col"${isSorted ? ` aria-sort="${sorting.direction}"` : ""}>
			<button type="button" class="lt-table__sort" data-column="${column}">${text}</button>
		</th>`
	}

	const surface = document.getElementById("demo-list")?.shadowRoot
	const root = surface?.getElementById("demo-list-root")
	const result = surface?.getElementById("demo-result")
	const matches = surface?.getElementById("demo-matches")
	const search = surface?.getElementById("demo-search") as HTMLInputElement | null

	/** The demo fails on purpose every third load, to show the error state. */
	let loads = 0

	function selectedFilters(): string[] {
		return [...(root?.querySelectorAll(".lt-tag[aria-pressed='true']") ?? [])].map(
			(button) => (button as HTMLElement).dataset.status ?? "",
		)
	}

	function showLoading() {
		if (!result) return
		result.innerHTML = `
			<div aria-busy="true">
				${'<div class="lt-skeleton" data-variant="text" aria-hidden="true"></div>'.repeat(3)}
			</div>`
		if (matches) matches.textContent = "Loading floors"
	}

	function showError() {
		if (!result) return
		result.innerHTML = `
			<div class="lt-alert" data-color="danger" role="alert">
				<p class="lt-alert__title">Could not fetch the floors</p>
				<p>The network did not respond. Try again.</p>
			</div>`
		// The alert has role="alert" and is announced by itself. The status
		// element is emptied, so the message does not come twice.
		if (matches) matches.textContent = ""
	}

	function showEmpty(searchTerm: string) {
		if (!result) return
		result.innerHTML = `
			<div>
				<p class="lt-paragraph"><strong id="demo-empty"></strong></p>
				<p class="lt-paragraph" data-size="small">Try another search term, or remove the filters.</p>
				<button class="lt-button" data-variant="secondary" type="button" id="demo-reset">
					Clear the search
				</button>
			</div>`
		// `textContent` and not straight into `innerHTML`: the search text is
		// written by the user, and `<img onerror=…>` in the search field would
		// have run.
		const empty = surface?.getElementById("demo-empty")
		if (empty) {
			empty.textContent = `No floors match${searchTerm ? ` “${searchTerm}”` : ""}.`
		}
		if (matches) matches.textContent = "No matches"

		surface?.getElementById("demo-reset")?.addEventListener("click", () => {
			if (search) search.value = ""
			for (const button of root?.querySelectorAll(".lt-tag") ?? []) {
				button.setAttribute("aria-pressed", "false")
			}
			render()
		})
	}

	function showFloors(floors: Floor[]) {
		if (!result) return
		shown = floors
		result.innerHTML = `
			<div class="lt-table-scroll" tabindex="0" role="region" aria-label="Free floors">
				<table class="lt-table" data-variant="striped">
					<caption class="lt-sr-only">Free floors that match the search. Columns with a button can be sorted.</caption>
					<thead>
						<tr>${header("floor", "Floor")}${header("height", "Above the water")}<th scope="col" data-align="end">Rent</th><th scope="col">Status</th></tr>
					</thead>
					<tbody>
						${sorted(floors)
							.map(
								(item) => `<tr>
									<th scope="row">Floor ${item.floor}</th>
									<td>${item.height} m</td>
									<td data-align="end">${item.rent}</td>
									<td>${item.status}</td>
								</tr>`,
							)
							.join("")}
					</tbody>
				</table>
			</div>`

		// Only when the count is different: sorting redraws the same floors, and
		// the same text written in again is announced again.
		const count = floors.length === 1 ? "1 floor" : `${floors.length} floors`
		if (matches && matches.textContent !== count) matches.textContent = count
	}

	function render() {
		loads += 1
		showLoading()

		window.setTimeout(() => {
			if (loads % 3 === 0) {
				showError()
				return
			}

			const searchTerm = (search?.value ?? "").trim().toLowerCase()
			const filters = selectedFilters()

			const matching = FLOORS.filter(
				(item) =>
					(searchTerm === "" ||
						`floor ${item.floor}`.includes(searchTerm) ||
						item.status.toLowerCase().includes(searchTerm)) &&
					(filters.length === 0 || filters.includes(item.status)),
			)

			if (matching.length === 0) showEmpty(searchTerm)
			else showFloors(matching)
		}, 450)
	}

	// Search while the user types, but not on every keystroke: the number of
	// matches is announced, and that would interrupt the announcement all the
	// time.
	let timeout: number
	search?.addEventListener("input", () => {
		window.clearTimeout(timeout)
		timeout = window.setTimeout(render, 300)
	})

	surface?.getElementById("demo-search-form")?.addEventListener("submit", (event) => {
		event.preventDefault()
		render()
	})

	for (const button of root?.querySelectorAll(".lt-tag[data-selectable]") ?? []) {
		button.addEventListener("click", () => {
			const selected = button.getAttribute("aria-pressed") === "true"
			button.setAttribute("aria-pressed", String(!selected))
			render()
		})
	}

	surface?.getElementById("demo-reload")?.addEventListener("click", render)

	// Sorting fetches nothing again, it draws the same floors in a new order.
	// The table is replaced, so focus has to be put back on the button the
	// user pressed, or it lands on `<body>`.
	result?.addEventListener("click", (event) => {
		const button = (event.target as Element).closest<HTMLElement>(".lt-table__sort")
		const column = button?.dataset.column as Column | undefined
		if (!column) return

		sorting = {
			column,
			direction:
				sorting.column === column && sorting.direction === "ascending"
					? "descending"
					: "ascending",
		}
		showFloors(shown)
		result
			.querySelector<HTMLElement>(`.lt-table__sort[data-column="${column}"]`)
			?.focus()
	})

	render()
</script>
