---
import Preview from "./Preview.astro"
---

<Preview
	id="demo-confirm"
	styles={["dialog", "button", "toast", "paragraph"]}
	layout="stack"
	maxWidth="34rem"
>
	<p class="lt-paragraph">Job 222-0481, ordered 4 March.</p>

	<button class="lt-button" data-variant="danger" type="button" id="demo-cancel">
		Cancel the job
	</button>

	<dialog class="lt-dialog" id="demo-dialog" aria-labelledby="demo-dialog-title">
		<h2 class="lt-dialog__title" id="demo-dialog-title">Cancel job 222-0481?</h2>

		<div class="lt-dialog__body">
			<p class="lt-paragraph">
				The crew keeps the advance. This cannot be undone.
			</p>
		</div>

		<form method="dialog" class="lt-dialog__footer">
			<button class="lt-button" data-variant="secondary" value="keep">Keep the job</button>
			<button class="lt-button" data-variant="danger" value="cancel">Cancel the job</button>
		</form>
	</dialog>

	<lt-toast id="demo-messages" label="Notifications"></lt-toast>
</Preview>

<script>
	import { defineLtToast } from "@lo-tek/interfaces/toast"

	defineLtToast()

	const surface = document.getElementById("demo-confirm")?.shadowRoot
	const dialog = surface?.getElementById("demo-dialog") as HTMLDialogElement | null
	const messages = surface?.getElementById("demo-messages") as
		| (HTMLElement & { show(text: string, options?: { color?: string }): void })
		| null

	surface?.getElementById("demo-cancel")?.addEventListener("click", () => {
		if (!dialog) return
		// Escape and close() without a value leave the previous value in place.
		dialog.returnValue = ""
		dialog.showModal()
	})

	dialog?.addEventListener("close", () => {
		if (dialog.returnValue !== "cancel") return

		// The action has been carried out. The message confirms it, but is not
		// the place for an undo button: it disappears.
		messages?.show("Job 222-0481 has been cancelled", { color: "success" })
	})
</script>
