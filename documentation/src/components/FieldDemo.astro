---
import Preview from "./Preview.astro"
---

<Preview id="demo-field" styles={["field"]} layout="stack" maxWidth="34rem">
	<lt-field>
		<label class="lt-label" for="demo-fixer-input" data-required="text">Fixer's address</label>
		<input
			id="demo-fixer-input"
			class="lt-input"
			type="email"
			placeholder="fixer@relay.example"
			required
		/>
		<p class="lt-help-text">The board writes to the fixer, never to the crew.</p>
		<p class="lt-error-text" id="demo-fixer-error" hidden>Enter a valid address.</p>
	</lt-field>

	<lt-field optional="">
		<label for="demo-note">Note for the fixer</label>
		<textarea id="demo-note" class="lt-textarea" rows="3" placeholder="No method. Objective only."></textarea>
		<p class="lt-help-text">Up to 500 characters. The fixer reads no more.</p>
	</lt-field>
</Preview>

<script>
	import { defineLtField } from "@lo-tek/interfaces/field"

	defineLtField()

	// The preview sits in a shadow root, so document.getElementById does
	// not reach inside. We go through the host element.
	const surface = document.getElementById("demo-field")?.shadowRoot
	const errorText = surface?.getElementById("demo-fixer-error")
	const input = surface?.getElementById("demo-fixer-input") as HTMLInputElement | null

	if (errorText && input) {
		const isValid = () =>
			input.value === "" || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value)

		// The field is invalid while the error text is visible. The component
		// then sets aria-invalid and wires the message to the field.
		input.addEventListener("blur", () => {
			errorText.hidden = isValid()
		})

		input.addEventListener("input", () => {
			if (!errorText.hidden) errorText.hidden = isValid()
		})
	}
</script>
