---
import Preview from "./Preview.astro"
---

<Preview
	id="demo-toast"
	styles={["toast", "button"]}
	maxWidth="30rem"
	fixedInside
	extraCss={`
		/* Only for the preview: the messages sit in the corner of the box, as
		   they sit in the corner of the window in an app. The height gives them
		   room. */
		.surface { min-block-size: 10rem; }
	`}
>
	<button class="lt-button" id="demo-toast-button" type="button">Restart relay 14</button>
	<lt-toast id="demo-toast-queue" label="Notifications"></lt-toast>
</Preview>

<script>
	import { defineLtToast } from "@lo-tek/interfaces/toast"

	defineLtToast()

	// The preview sits in a shadow root, so we go through the host element.
	const surface = document.getElementById("demo-toast")?.shadowRoot
	const button = surface?.getElementById("demo-toast-button")
	const messages = surface?.getElementById("demo-toast-queue")

	button?.addEventListener("click", () => {
		messages?.show("Relay 14 is back", { color: "success" })
	})
</script>
