---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// The server writes the whole box: the class, the role, the tab stop and
// the heading. The component only moves focus and handles clicks on the links.
const summary = lt.errorSummary({
  count: 2,
  id: "demo-summary",
})
---

<Preview
	id="demo-error-summary"
	styles={["error-summary", "list", "label", "input", "button", "error-text"]}
	layout="stack"
	maxWidth="34rem"
>
	<form id="demo-form" novalidate>
		<lt-error-summary {...summary.host} data-autofocus="false">
			<h2 {...summary.title}>The form has two errors</h2>
			<ul class="lt-list">
				<li><a href="#demo-fixer">Enter the fixer's address with an @ sign</a></li>
				<li><a href="#demo-deliver-by">Enter the date as day, month and year</a></li>
			</ul>
		</lt-error-summary>

		<label class="lt-label" for="demo-fixer">Fixer's address</label>
		<input class="lt-input" id="demo-fixer" type="email" value="fixer.relay.example" data-state="invalid" aria-invalid="true" />

		<label class="lt-label" for="demo-deliver-by">Deliver by</label>
		<input class="lt-input" id="demo-deliver-by" type="date" data-state="invalid" aria-invalid="true" />
	</form>
</Preview>

<script>
	import { defineLtErrorSummary } from "@lo-tek/interfaces/error-summary"

	defineLtErrorSummary()
</script>
