---
/**
 * The theme builder: set the keys of a theme recipe, and see what the
 * generator makes of them.
 *
 * The page is written with Datastar. The state is signals, the fields are
 * bound to them, and what is shown is computed from them in the markup. The
 * one thing Datastar cannot do is build the theme: that is the core, in
 * WebAssembly, the same one `lotek theme` runs. The module at the foot loads
 * it and hands it to Datastar as two actions, through Datastar's own
 * `action()`. Nothing else here is script.
 *
 * The fields are not written by hand. `theme.schema.json` says which keys a
 * recipe has, and the page has one field for each, so a key the generator
 * gets is a field here the next time the site is built. The schema's own
 * tests hold it to the keys the core knows.
 *
 * Everything happens in the browser. The recipe is never sent anywhere, and
 * nothing here is part of what a consumer ships: a theme is a CSS file.
 *
 * The page is always dark, like the front page, and in its profile.
 */

import "@lo-tek/interfaces/lotek.css"
import "../styles/profile.css"
import pkg from "../../../interfaces/package.json" with { type: "json" }
import schema from "../../../interfaces/src/tokens/theme.schema.json"
import FontPreload from "../components/FontPreload.astro"
import Logo from "../components/Logo.astro"
import { metaAttributes, SHARE_IMAGE } from "../share-image.mjs"

const title = "Theme builder | LO-TEK Interfaces"
const description =
  "Set your brand colours, font and corners, and see LO-TEK's components with the theme the generator builds from them, in light and dark."

type Property = {
  description?: string
  properties?: Record<string, Property>
}

/** The first sentence of a description: what the key is for. */
const first = (text = "") => text.split(/(?<=\.)\s/)[0]

const top = schema.properties as Record<string, Property>
/** The colour families: every key at the top that is not a block or `$schema`. */
const families = Object.entries(top).filter(
  ([name, property]) => name !== "$schema" && !property.properties,
)

type Field = { path: string; label: string; help: string }

/** Every leaf below a block, with its path: `typography.weights.bold`. */
const leaves = (path: string, property: Property): Field[] =>
  Object.entries(property.properties ?? {}).flatMap(([name, child]) =>
    child.properties
      ? leaves(`${path}.${name}`, child)
      : [
          {
            path: `${path}.${name}`,
            label: `${path}.${name}`.split(".").slice(1).join(" "),
            help: child.description ?? "",
          },
        ],
  )
const typography = leaves("typography", top.typography)
const shape = leaves("shape", top.shape)

/** An empty value at every leaf, in the shape of the recipe. */
const empty = (property: Property): Record<string, unknown> =>
  Object.fromEntries(
    Object.entries(property.properties ?? {}).map(([name, child]) => [
      name,
      child.properties ? empty(child) : "",
    ]),
  )

/**
 * The sentences a row of the report can hold, as `lotek theme` writes them:
 * why the colour could not be the fill in an appearance, and how much of its
 * chroma the fill has there.
 */
const WHY = ["lightWhy", "darkWhy", "lightChroma", "darkChroma"] as const

/*
 * The signals. `own` says which families have a colour of the consumer's,
 * `fields` holds what is written in every field, in the shape of the recipe.
 * `recipe` is what was chosen and only that, as the text of the recipe file,
 * and `built` is the core's answer to it: the theme, what is wrong with
 * each field, in the shape of `fields`, and what became of each colour.
 * `shown` is the theme the frames have, the last one that was built, and
 * `view` which page they frame. `copied` is the recipe that was last
 * copied. `pasted` is the text in the field a recipe
 * can be pasted into, and `pasteError` why it was not taken.
 *
 * A signal an action answers into always has the same keys, and only text,
 * numbers and booleans at its leaves. Datastar merges what is assigned into
 * what is there, and an answer that gains a key, loses one or holds a list
 * is a change every time: the effect that assigned it then runs again, for
 * ever. So the recipe is kept as text, and `built` has every key from the
 * start.
 */
const signals = {
  ready: false,
  own: Object.fromEntries(families.map(([name]) => [name, false])),
  fields: {
    ...Object.fromEntries(families.map(([name]) => [name, ""])),
    typography: empty(top.typography),
    shape: empty(top.shape),
  },
  recipe: "{}",
  built: {
    ok: false,
    css: "",
    error: "",
    wrong: {
      ...Object.fromEntries(families.map(([name]) => [name, ""])),
      typography: empty(top.typography),
      shape: empty(top.shape),
    },
    report: Object.fromEntries(
      families.map(([name]) => [
        name,
        {
          given: "",
          light: "",
          dark: "",
          ...Object.fromEntries(WHY.map((key) => [key, ""])),
        },
      ]),
    ),
  },
  shown: "",
  view: "sheet",
  copied: "",
  pasted: "",
  pasteError: "",
}

/** The two appearances a theme has, each in a frame of its own. */
const APPEARANCES = ["light", "dark"] as const

/**
 * The command that builds the theme from the recipe file, with the version
 * the page is built with: the page shows what that version makes of the
 * recipe, and a newer or an older one may make something else.
 */
const COMMAND = `npx @lo-tek/interfaces@${pkg.version} theme lotek.theme.json --out=theme.css`

const id = (path: string) => `field-${path.replaceAll(".", "-")}`
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<FontPreload />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- The page sits outside Starlight, so the tags for shared links,
		     which Starlight writes on the other pages, are here. -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL("/theme-builder/", Astro.site).href} />
		<meta property="og:locale" content="en" />
		<meta property="og:site_name" content="LO-TEK Interfaces" />
		<meta name="twitter:card" content="summary_large_image" />
		{
			SHARE_IMAGE.map((tag) => {
				const { property, name, content } = metaAttributes(tag)
				return <meta property={property} name={name} content={content} />
			})
		}
		<script type="module" src="/datastar.js" data-datastar is:inline></script>
	</head>
	<body class="profile-grain" data-signals={JSON.stringify(signals)}>
		<a class="lt-skip-link" href="#content">Skip to content</a>

		<div class="builder">
			<header class="builder__top">
				<a class="builder__home" href="/" aria-label="LO-TEK Interfaces, front page">
					<Logo size="sm" />
				</a>
				<nav aria-label="Main">
					<a class="builder__back" href="/your-own-theme/">Your own theme</a>
				</nav>
			</header>

			<main class="builder__main" id="content" tabindex="-1">
				<div class="builder__head">
					<h1 class="builder__name profile-name">Theme builder</h1>
					<p class="builder__line">
						Set what is yours. The generator builds the rest, and keeps the
						contrast promises in both themes. Nothing leaves this page.
					</p>
					<p class="profile-label">
						Built with @lo-tek/interfaces {pkg.version}
					</p>
				</div>

				<!-- What was chosen becomes the recipe, and the recipe becomes the
				     theme. The core is asked only when it has been loaded. -->
				<div hidden data-effect="$ready && ($recipe = @recipe($own, $fields))"></div>
				<div hidden data-effect="$ready && ($built = @buildTheme($recipe, $own, $fields))"></div>
				<div hidden data-effect="$ready && ($built.ok ? ($shown = $built.css) : $built.error === '' && ($shown = ''))"></div>

				<section class="builder__recipe" aria-labelledby="recipe-title">
					<h2 class="profile-label" id="recipe-title">Recipe</h2>

					<fieldset class="lt-fieldset builder__group">
						<legend class="lt-legend">Colours</legend>
						{
							families.map(([name, property]) => (
								<div class="builder__family">
									<div class="lt-switch-row">
										<input
											class="lt-switch"
											type="checkbox"
											role="switch"
											id={`own-${name}`}
											name={`own.${name}`}
											data-bind={`own.${name}`}
										/>
										<label class="lt-label" for={`own-${name}`}>
											{name}
										</label>
									</div>
									<!-- The picker writes into the field, and follows it only
									     while the field holds a whole colour: a picker takes
									     nothing but #rrggbb, and says so in the console for
									     every key pressed on the way there. -->
									<div class="builder__colour">
										<input
											class="builder__picker"
											type="color"
											aria-label={`Pick the colour of ${name}`}
											disabled
											data-on:input={`$fields.${name} = el.value`}
											data-effect={`/^#[0-9a-f]{6}$/i.test($fields.${name}) && (el.value = $fields.${name})`}
											data-attr:disabled={`!$own.${name}`}
										/>
										<input
											class="lt-input"
											type="text"
											id={id(name)}
											name={name}
											aria-label={`The colour of ${name}, as #rrggbb`}
											aria-describedby={`${id(name)}-help ${id(name)}-error`}
											placeholder="#rrggbb"
											autocomplete="off"
											spellcheck="false"
											disabled
											data-bind={`fields.${name}`}
											data-attr:disabled={`!$own.${name}`}
											data-attr:aria-invalid={`$built.wrong.${name} !== '' && 'true'`}
											data-attr:data-state={`$built.wrong.${name} !== '' && 'invalid'`}
										/>
									</div>
									<p
										class="lt-error-text"
										id={`${id(name)}-error`}
										style="display: none"
										data-show={`$built.wrong.${name} !== ''`}
										data-text={`$built.wrong.${name}`}
									/>
									<p class="lt-help-text" id={`${id(name)}-help`}>
										{first(property.description)}
									</p>
								</div>
							))
						}
					</fieldset>

					{
						[
							{ legend: "Typography", fields: typography },
							{ legend: "Shape", fields: shape },
						].map(({ legend, fields }) => (
							<fieldset class="lt-fieldset builder__group">
								<legend class="lt-legend">{legend}</legend>
								{fields.map(({ path, label, help }) => (
									<div class="builder__field">
										<label class="lt-label" for={id(path)}>
											{label}
										</label>
										<input
											class="lt-input"
											type="text"
											id={id(path)}
											name={path}
											aria-describedby={`${id(path)}-help ${id(path)}-error`}
											autocomplete="off"
											spellcheck="false"
											data-bind={`fields.${path}`}
											data-attr:aria-invalid={`$built.wrong.${path} !== '' && 'true'`}
											data-attr:data-state={`$built.wrong.${path} !== '' && 'invalid'`}
										/>
										<p
											class="lt-error-text"
											id={`${id(path)}-error`}
											style="display: none"
											data-show={`$built.wrong.${path} !== ''`}
											data-text={`$built.wrong.${path}`}
										/>
										<p class="lt-help-text" id={`${id(path)}-help`}>
											{help}
										</p>
									</div>
								))}
							</fieldset>
						))
					}
				</section>

				<div class="builder__side">
				<section class="builder__preview" aria-labelledby="preview-title">
					<div class="builder__preview-head">
						<h2 class="profile-label" id="preview-title">Preview</h2>
						<fieldset class="lt-toggle-group">
							<legend class="lt-sr-only">What the theme is shown on</legend>
							<label class="lt-toggle-group__option">
								<input type="radio" name="view" value="sheet" checked data-bind="view" />
								Components
							</label>
							<label class="lt-toggle-group__option">
								<input type="radio" name="view" value="page" data-bind="view" />
								Page
							</label>
						</fieldset>
					</div>
					<!-- Each frame is a page of the site with the theme laid on it,
					     the file itself and not a likeness of it. The frame says
					     which appearance it is, and the framed page takes it before
					     it paints. -->
					<div class="builder__frames">
						{
							APPEARANCES.map((appearance) => (
								<figure class="builder__frame">
									<figcaption class="profile-label">{appearance}</figcaption>
									<iframe
										title={`The theme in the ${appearance} appearance`}
										data-appearance={appearance}
										src="/theme-builder/sheet/"
										data-attr:src="'/theme-builder/' + $view + '/'"
										data-effect={`$ready && @showTheme(el, '${appearance}', $shown)`}
									/>
								</figure>
							))
						}
					</div>
				</section>

				<section class="builder__report" aria-labelledby="report-title">
					<h2 class="profile-label" id="report-title">What became of your colours</h2>
					<p class="builder__line">
						The lightness of every colour is the role's, so a colour is moved
						to it, and a light one far. Each row says what yours became, and why
						it could not be the fill as it was.
					</p>
					<!-- A row for every family, each shown when the recipe gives the
					     family. Not a list written by script: Datastar has the rows,
					     and the answer fills them in. -->
					{
						families.map(([name]) => (
							<div
								class="builder__row"
								data-family={name}
								style="display: none"
								data-show={`$built.report.${name}.given !== ''`}
							>
								<p class="profile-label">{name}</p>
								<p class="builder__swatches">
									{(["given", "light", "dark"] as const).map((key) => (
										<span class="builder__colour-of">
											<span class="profile-label">{key}</span>
											<span
												class="builder__swatch"
												data-attr:style={`'background-color: ' + $built.report.${name}.${key}`}
											/>
											<code data-text={`$built.report.${name}.${key}`} />
										</span>
									))}
								</p>
								{WHY.map((key) => (
									<p
										class="builder__why"
										style="display: none"
										data-show={`$built.report.${name}.${key} !== ''`}
										data-text={`$built.report.${name}.${key}`}
									/>
								))}
							</div>
						))
					}
				</section>

				<section class="builder__out" aria-labelledby="out-title">
					<h2 class="profile-label" id="out-title">lotek.theme.json</h2>
					<pre class="builder__json" data-recipe tabindex="0" data-text="$recipe">{"{}"}</pre>
					<!-- What was chosen is remembered in this browser. `copied` is the
					     recipe that was copied, so "Copied" is said only of that one. -->
					<div hidden data-effect="$ready && @remember($own, $fields)"></div>
					<p class="builder__actions">
						<button
							class="lt-button"
							type="button"
							disabled
							data-attr:disabled="!$built.ok"
							data-on:click="@copy($recipe); $copied = $recipe"
						>
							Copy the recipe
						</button>
						<a
							class="lt-button"
							data-variant="secondary"
							download="theme.css"
							style="display: none"
							data-show="$built.ok"
							data-attr:href="$built.ok ? 'data:text/css;charset=utf-8,' + encodeURIComponent($built.css) : ''"
						>
							Download theme.css
						</a>
						<button
							class="lt-button"
							data-variant="ghost"
							type="button"
							data-on:click="@startAgain()"
						>
							Start again
						</button>
						<span class="builder__said" role="status" data-text="$copied !== '' && $copied === $recipe ? 'Copied.' : ''"></span>
					</p>
					<p class="builder__line">
						Keep the recipe in the repository as <code>lotek.theme.json</code>,
						and build the theme from it:
					</p>
					<pre class="builder__json" tabindex="0"><code>{COMMAND}</code></pre>
				</section>

				<section class="builder__out" aria-labelledby="paste-title">
					<h2 class="profile-label" id="paste-title">A recipe you have</h2>
					<div class="builder__field">
						<label class="lt-label" for="paste">Paste a recipe</label>
						<textarea
							class="lt-textarea"
							id="paste"
							rows="6"
							spellcheck="false"
							aria-describedby="paste-help paste-error"
							data-bind="pasted"
							data-attr:aria-invalid="$pasteError !== '' && 'true'"
							data-attr:data-state="$pasteError !== '' && 'invalid'"></textarea>
						<p
							class="lt-error-text"
							id="paste-error"
							style="display: none"
							data-show="$pasteError !== ''"
							data-text="$pasteError"
						>
						</p>
						<p class="lt-help-text" id="paste-help">
							The text of a <code>lotek.theme.json</code>. It replaces what is chosen above.
						</p>
					</div>
					<p class="builder__actions">
						<button
							class="lt-button"
							data-variant="secondary"
							type="button"
							data-on:click="@useRecipe($pasted)"
						>
							Use this recipe
						</button>
					</p>
				</section>
				</div>
			</main>
		</div>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		font-family: var(--profile-font-text);
		color: var(--lt-color-neutral-text-strong);
		background: var(--lt-color-neutral-canvas);
	}

	.builder {
		max-inline-size: 90rem;
		margin-inline: auto;
		padding: var(--lt-spacing-6);
	}

	.builder__top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--lt-spacing-4);
		padding-block-end: var(--lt-spacing-6);
	}

	.builder__home {
		color: inherit;
		text-decoration: none;
	}

	.builder__back {
		font-family: var(--profile-font-data);
		font-size: var(--lt-font-size-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--lt-color-neutral-text-strong);
	}

	.builder__main {
		display: grid;
		grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
		gap: var(--lt-spacing-8);
		align-items: start;
	}

	.builder__main:focus {
		outline: none;
	}

	.builder__head {
		grid-column: 1 / -1;
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-3);
	}

	.builder__name {
		margin: 0;
		font-size: var(--lt-font-size-xxl);
	}

	.builder__line {
		margin: 0;
		max-inline-size: 40rem;
		line-height: var(--lt-line-height-article);
		color: var(--lt-color-neutral-text);
	}

	.builder__recipe,
	.builder__out,
	.builder__group {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-4);
		min-inline-size: 0;
	}

	.builder__family,
	.builder__field {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-1);
	}

	.builder__colour {
		display: flex;
		gap: var(--lt-spacing-2);
	}

	.builder__picker {
		flex: none;
		inline-size: var(--lt-spacing-10);
		block-size: auto;
		padding: 0;
		border: var(--profile-rule);
		background: none;
	}

	.builder__json {
		margin: 0;
		padding: var(--lt-spacing-4);
		overflow: auto;
		border: var(--profile-rule);
		font-family: var(--profile-font-data);
		font-size: var(--lt-font-size-s);
		line-height: var(--lt-line-height-default);
	}

	.builder__report {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-4);
	}

	.builder__row {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-2);
		padding-block-start: var(--lt-spacing-3);
		border-block-start: var(--profile-rule-subtle);
	}

	.builder__row > p {
		margin: 0;
	}

	.builder__swatches {
		display: flex;
		flex-wrap: wrap;
		gap: var(--lt-spacing-6);
	}

	.builder__colour-of {
		display: inline-flex;
		align-items: center;
		gap: var(--lt-spacing-2);
		font-family: var(--profile-font-data);
		font-size: var(--lt-font-size-s);
	}

	.builder__swatch {
		display: inline-block;
		inline-size: var(--lt-spacing-8);
		block-size: var(--lt-spacing-8);
		border: var(--profile-rule);
	}

	.builder__why {
		max-inline-size: 60rem;
		font-size: var(--lt-font-size-s);
		line-height: var(--lt-line-height-article);
		color: var(--lt-color-neutral-text);
	}

	.builder__side {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-8);
		min-inline-size: 0;
	}

	.builder__preview {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-4);
	}

	.builder__preview-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--lt-spacing-4);
	}

	.builder__frames {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
		gap: var(--lt-spacing-4);
	}

	.builder__frame {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-2);
		min-inline-size: 0;
		margin: 0;
	}

	.builder__frame iframe {
		display: block;
		inline-size: 100%;
		block-size: min(46rem, 80vh);
		border: var(--profile-rule);
	}

	.builder__said {
		font-family: var(--profile-font-data);
		font-size: var(--lt-font-size-s);
		color: var(--lt-color-neutral-text);
	}

	.builder__actions {
		margin: 0;
	}

	@media (max-width: 48rem) {
		.builder__main {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import contract from "@lo-tek/interfaces/color-contract.json?raw"
	import wasm from "@lo-tek/interfaces/core.wasm?url"
	import { loadCore } from "@lo-tek/interfaces/diagnostics"

	/*
	 * The module: the core, handed to Datastar as two actions.
	 *
	 * Datastar is taken from the address the page loaded it from, so this is
	 * the same instance the markup runs on, and not a second copy bundled in
	 * here. `action()` is Datastar's own way to add an action, shown in its
	 * "custom plugin" example and not promised to stay as it is:
	 * `datastar-extension.browser.test.ts` says so when it changes.
	 */
	const address = document.querySelector<HTMLScriptElement>(
		"script[data-datastar]",
	)?.src
	const { action, mergePatch } = await import(/* @vite-ignore */ address ?? "")

	const core = loadCore(
		await WebAssembly.compile(await (await fetch(wasm)).arrayBuffer()),
	)
	core.loadContract(contract)

	type Fields = { [key: string]: string | Fields }

	/** The fields that have a value, in the shape they have. Nothing when none has. */
	const filled = (fields: Fields): Fields | undefined => {
		const kept: Fields = {}
		for (const [name, value] of Object.entries(fields)) {
			const own = typeof value === "string" ? value.trim() : filled(value)
			if (own !== undefined && own !== "") kept[name] = own
		}
		return Object.keys(kept).length > 0 ? kept : undefined
	}

	// What was chosen, and only that: a family when its switch is on and its
	// field has a value, a key of typography or shape when its field has one.
	action({
		name: "recipe",
		apply(_: unknown, own: Record<string, boolean>, fields: Fields) {
			const chosen: Fields = {}
			for (const [name, value] of Object.entries(fields)) {
				if (typeof value !== "string") continue
				if (own[name] && value.trim() !== "") chosen[name] = value.trim()
			}
			return JSON.stringify(
				{
					...chosen,
					...filled({ typography: fields.typography, shape: fields.shape }),
				},
				null,
				2,
			)
		},
	})

	type Broken = { promise: string; ratio: number; required: number }
	type Fill = { fill: string; chromaKept: number; breaks: Broken[] }
	type Row = Record<string, string>

	/** The two sentences about one appearance, as `lotek theme` writes them. */
	const why = (appearance: string, given: string, fill: Fill) => {
		const percent = Math.round(fill.chromaKept * 100)
		return [
			fill.breaks.length === 0
				? ""
				: `In the ${appearance} theme ${given} could not be the fill itself: ${fill.breaks
						.map(
							(b) =>
								`${b.promise} would be ${b.ratio.toFixed(2)}:1, the requirement is ${b.required}:1`,
						)
						.join("; ")}.`,
			percent < 100
				? `In the ${appearance} theme the fill has ${percent}% of the chroma of ${given}: sRGB cannot show more at that lightness and hue.`
				: "",
		]
	}

	/** What the core answers to a recipe of one key, when it refuses it. */
	const refusal = (recipe: Fields): string => {
		try {
			core.buildTheme(recipe)
			return ""
		} catch (error) {
			return error instanceof Error ? error.message : String(error)
		}
	}

	/** What is wrong with every field of a block, in the shape of the block. */
	const wrongIn = (block: Fields, alone: (leaf: Fields) => Fields): Fields =>
		Object.fromEntries(
			Object.entries(block).map(([name, value]) => [
				name,
				typeof value !== "string"
					? wrongIn(value, (leaf) => alone({ [name]: leaf }))
					: value.trim() === ""
						? ""
						: refusal(alone({ [name]: value.trim() })),
			]),
		)

	// The report of the last theme that was built: what the rows hold while
	// a field is being typed in and the recipe does not build.
	let lastReport: Record<string, Row> | undefined

	// The core's answer to a recipe: the theme, what is wrong with each
	// field, and what became of each colour. A recipe with nothing in it is
	// not a mistake, only nothing yet. Every answer has the same keys; see
	// the note at the signals.
	action({
		name: "buildTheme",
		apply(_: unknown, recipe: string, own: Record<string, boolean>, fields: Fields) {
			const families = Object.keys(own)
			const noRow = { given: "", light: "", dark: "", lightWhy: "", darkWhy: "", lightChroma: "", darkChroma: "" }
			const empty = Object.fromEntries(families.map((name) => [name, { ...noRow }]))
			// A field is asked about alone, so the answer is about that field:
			// the core stops at the first thing it refuses.
			const wrong: Fields = {
				...Object.fromEntries(
					families.map((name) => {
						const value = fields[name]
						return [
							name,
							own[name] && typeof value === "string" && value.trim() !== ""
								? refusal({ [name]: value.trim() })
								: "",
						]
					}),
				),
				typography: wrongIn(fields.typography as Fields, (leaf) => ({ typography: leaf })),
				shape: wrongIn(fields.shape as Fields, (leaf) => ({ shape: leaf })),
			}
			const chosen = JSON.parse(recipe)
			if (Object.keys(chosen).length === 0) {
				lastReport = undefined
				return { ok: false, css: "", error: "", wrong, report: empty }
			}
			try {
				const { css, brands } = core.buildTheme(chosen)
				const report = { ...empty }
				for (const brand of brands) {
					const [lightWhy, lightChroma] = why("light", brand.given, brand.light)
					const [darkWhy, darkChroma] = why("dark", brand.given, brand.dark)
					report[brand.family] = {
						given: brand.given,
						light: brand.light.fill,
						dark: brand.dark.fill,
						lightWhy,
						darkWhy,
						lightChroma,
						darkChroma,
					}
				}
				lastReport = report
				return { ok: true, css, error: "", wrong, report }
			} catch (error) {
				return {
					ok: false,
					css: "",
					error: error instanceof Error ? error.message : String(error),
					wrong,
					report: lastReport ?? empty,
				}
			}
		},
	})

	/*
	 * The theme of a frame: the appearance on `<html>`, and the CSS in one
	 * `<style>` in `<head>`, the file as the generator writes it. An empty
	 * theme empties the element, and the page shows LO-TEK's own colours.
	 */
	const themes = new WeakMap<HTMLIFrameElement, { appearance: string; css: string }>()

	const lay = (frame: HTMLIFrameElement) => {
		const theme = themes.get(frame)
		const page = frame.contentDocument
		// Before the page has come, or between two pages: `load` lays it then.
		if (!theme || !page?.head || page.location.href === "about:blank") return
		page.documentElement.dataset.theme = theme.appearance
		page.documentElement.style.colorScheme = theme.appearance
		let style = page.head.querySelector<HTMLStyleElement>("style[data-theme-builder]")
		if (!style) {
			if (theme.css === "") return
			style = page.createElement("style")
			style.setAttribute("data-theme-builder", "")
			page.head.append(style)
		}
		if (style.textContent !== theme.css) style.textContent = theme.css
	}

	// A frame is given a theme now and again every time it has loaded a page:
	// the other page of the two, or the same one once more.
	action({
		name: "showTheme",
		apply(_: unknown, frame: HTMLIFrameElement, appearance: string, css: string) {
			if (!themes.has(frame)) frame.addEventListener("load", () => lay(frame))
			themes.set(frame, { appearance, css })
			lay(frame)
		},
	})

	/*
	 * The page as on a first visit: what the markup itself says the signals
	 * are. It is the shape of `own` and `fields`, for a recipe that is pasted
	 * in and for what was remembered, and what "Start again" goes back to.
	 */
	const first = JSON.parse(document.body.getAttribute("data-signals") ?? "{}") as {
		own: Record<string, boolean>
		fields: Fields
	}
	const REMEMBERED = "lotek-theme-builder"

	/** The values of `from` laid into the shape of `blank`, as text. Anything else is left out. */
	const laid = (blank: Fields, from: unknown): Fields =>
		Object.fromEntries(
			Object.entries(blank).map(([name, value]) => {
				const given = (from as Record<string, unknown> | null)?.[name]
				if (typeof value !== "string") return [name, laid(value, given)]
				return [
					name,
					typeof given === "string" || typeof given === "number" ? String(given) : "",
				]
			}),
		)

	// What is chosen is kept in this browser and nowhere else. Storage can be
	// switched off, and then the page works without remembering.
	action({
		name: "remember",
		apply(_: unknown, own: Record<string, boolean>, fields: Fields) {
			try {
				localStorage.setItem(REMEMBERED, JSON.stringify({ own, fields }))
			} catch {
				// Nothing to do: the page is as useful, only not next time.
			}
		},
	})

	action({
		name: "startAgain",
		apply() {
			try {
				localStorage.removeItem(REMEMBERED)
			} catch {
				// As above.
			}
			mergePatch({ own: first.own, fields: first.fields, pasted: "", pasteError: "" })
		},
	})

	action({
		name: "copy",
		apply(_: unknown, text: string) {
			return navigator.clipboard.writeText(text)
		},
	})

	// A recipe file pasted in becomes what is chosen. A text that is not a
	// recipe changes nothing and says why. A key the core does not know is
	// the core's to name. A value it refuses is taken: the field then holds
	// it, and says what is wrong with it.
	action({
		name: "useRecipe",
		apply(_: unknown, text: string) {
			const refuse = (pasteError: string) => mergePatch({ pasteError })
			let recipe: unknown
			try {
				recipe = JSON.parse(text)
			} catch {
				return refuse("This is not JSON. Paste the text of a lotek.theme.json.")
			}
			if (recipe === null || typeof recipe !== "object" || Array.isArray(recipe))
				return refuse("This is JSON, but not a recipe. A recipe is an object with the colours in it.")
			const { $schema: _schema, ...keys } = recipe as Record<string, unknown>
			const answer = refusal(keys as Fields)
			if (answer.startsWith("Unknown key in the recipe")) return refuse(answer)
			const fields = laid(first.fields, keys)
			mergePatch({
				own: Object.fromEntries(
					Object.keys(first.own).map((name) => [name, fields[name] !== ""]),
				),
				fields,
				pasteError: "",
			})
		},
	})

	// What was left the last time, before Datastar is told the core is here.
	try {
		const kept = JSON.parse(localStorage.getItem(REMEMBERED) ?? "null")
		if (kept)
			mergePatch({
				own: Object.fromEntries(
					Object.keys(first.own).map((name) => [name, kept.own?.[name] === true]),
				),
				fields: laid(first.fields, kept.fields),
			})
	} catch {
		// Nothing remembered that can be read. The page starts empty.
	}

	mergePatch({ ready: true })
</script>
