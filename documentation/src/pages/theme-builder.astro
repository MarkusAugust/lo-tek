---
/**
 * The theme builder: set the keys of a theme recipe, and see what the
 * generator makes of them.
 *
 * The page is written with Datastar. The state is signals, the fields are
 * bound to them, and what is shown is computed from them in the markup. The
 * one thing Datastar cannot do is build the theme: that is the core, in
 * WebAssembly, the same one `lotek theme` runs. The module at the foot loads
 * it and hands Datastar what the markup cannot do itself, as actions through
 * Datastar's own `action()`: the recipe from the fields, the core's answer
 * to it, the theme into a frame, one frame's scrolling to the other, the
 * fields from a recipe that is pasted in, and what was chosen into the
 * browser's storage and out again. Nothing
 * else here is script.
 *
 * The fields are not written by hand. `theme.schema.json` says which keys a
 * recipe has, and the page has one field for each, so a key the generator
 * gets is a field here the next time the site is built. The schema's own
 * tests hold it to the keys the core knows.
 *
 * Everything happens in the browser. The recipe is never sent anywhere, and
 * nothing here is part of what a consumer ships: a theme is a CSS file.
 *
 * The page is always dark, like the front page, and in its profile.
 */

import "@lo-tek/interfaces/lotek.css"
import "../styles/profile.css"
import pkg from "../../../interfaces/package.json" with { type: "json" }
import contract from "../../../interfaces/src/tokens/color-contract.json"
import schema from "../../../interfaces/src/tokens/theme.schema.json"
import FontPreload from "../components/FontPreload.astro"
import Top from "../components/Top.astro"
import { metaAttributes, SHARE_IMAGE } from "../share-image.mjs"

const title = "Theme builder | LO-TEK Interfaces"
const description =
  "Set your brand colours, font and corners, and see LO-TEK's components with the theme the generator builds from them, in light and dark."

type Property = {
  description?: string
  properties?: Record<string, Property>
}

/** The first sentence of a description: what the key is for. */
const first = (text = "") => text.split(/(?<=\.)\s/)[0]

const top = schema.properties as Record<string, Property>
/** The colour families: every key at the top that is not a block or `$schema`. */
const families = Object.entries(top).filter(
  ([name, property]) => name !== "$schema" && !property.properties,
)

/**
 * A slider beside a field whose value is a number: where it starts and
 * ends, and where it rests, which is the value LO-TEK has when the recipe
 * leaves the key out. `unit` is what is written after the number.
 */
type Range = {
  min: number
  max: number
  step: number
  rest: number
  unit: string
  /**
   * What the field holds at rest: LO-TEK's value as text, or nothing where
   * LO-TEK has no one value, and then `none` says what holds instead.
   */
  text: string
  none?: string
}

const WEIGHT = { min: 100, max: 900, step: 100, unit: "" }
/** A corner at rest is `--lt-spacing-1`, as `tokens.css` writes it. */
const CORNER = {
  min: 0,
  max: 32,
  step: 1,
  unit: "px",
  rest: 4,
  text: "0.25rem",
}

/**
 * The keys of `shape`. Their resting values are the fallbacks in the
 * component CSS: `--lt-spacing-1` for a corner, `1px` for the border and the
 * medium weight for the button text. Most surfaces have that corner; the
 * card and the dialog have twice it.
 */
const SHAPE: Record<string, Range> = {
  "shape.buttonRadius": CORNER,
  "shape.fieldRadius": CORNER,
  "shape.surfaceRadius": {
    ...CORNER,
    text: "",
    none: "0.25rem, and 0.5rem on card and dialog",
  },
  "shape.buttonBorderWidth": {
    min: 0,
    max: 4,
    step: 1,
    rest: 1,
    unit: "px",
    text: "1px",
  },
  "shape.buttonFontWeight": {
    ...WEIGHT,
    rest: 500,
    text: "",
    none: "as weights medium",
  },
}

/** The weights and line heights say in the schema what they are if left out. */
const rangeOf = (path: string, help: string): Range | undefined => {
  const said = help.match(/([\d.]+) if left out/)
  if (!said) return SHAPE[path]
  const rest = Number(said[1])
  return rest >= 100
    ? { ...WEIGHT, rest, text: said[1] }
    : { min: 1, max: 2, step: 0.05, rest, unit: "", text: said[1] }
}

/**
 * The slider follows the field: at rest while the field is empty, at the
 * number when the field holds one it can show, and where it was when the
 * field holds something else, `calc(1rem + 2px)` or `bold`.
 */
const follows = (path: string, { rest, unit }: Range) => {
  const field = `$fields.${path}`
  const number = "\\s*\\d*\\.?\\d+"
  return unit === ""
    ? `${field} === '' ? (el.value = ${rest}) : /^${number}\\s*$/.test(${field}) && (el.value = parseFloat(${field}))`
    : `${field} === '' ? (el.value = ${rest}) : /^(${number}px|\\s*0)\\s*$/.test(${field}) ? (el.value = parseFloat(${field})) : /^${number}rem\\s*$/.test(${field}) && (el.value = parseFloat(${field}) * 16)`
}

type Field = { path: string; label: string; help: string; range?: Range }

/** Every leaf below a block, with its path: `typography.weights.bold`. */
const leaves = (path: string, property: Property): Field[] =>
  Object.entries(property.properties ?? {}).flatMap(([name, child]) =>
    child.properties
      ? leaves(`${path}.${name}`, child)
      : [
          {
            path: `${path}.${name}`,
            label: `${path}.${name}`.split(".").slice(1).join(" "),
            help: child.description ?? "",
            range: rangeOf(`${path}.${name}`, child.description ?? ""),
          },
        ],
  )
const typography = leaves("typography", top.typography)
const shape = leaves("shape", top.shape)

/** LO-TEK's value at every leaf that has one, in the shape of the recipe. */
const resting = (path: string, property: Property): Record<string, unknown> =>
  Object.fromEntries(
    Object.entries(property.properties ?? {}).map(([name, child]) => [
      name,
      child.properties
        ? resting(`${path}.${name}`, child)
        : (rangeOf(`${path}.${name}`, child.description ?? "")?.text ?? ""),
    ]),
  )

/**
 * What a field says below it. That a key has a value when it is left out is
 * for the editor, where the key is not there: here the value is in the field.
 */
const below = (help: string) => help.replace(/\s*[\d.]+ if left out\./, "")

/** An empty value at every leaf, in the shape of the recipe. */
const empty = (property: Property): Record<string, unknown> =>
  Object.fromEntries(
    Object.entries(property.properties ?? {}).map(([name, child]) => [
      name,
      child.properties ? empty(child) : "",
    ]),
  )

/**
 * The sentences a row of the report can hold, as `lotek theme` writes them:
 * why the colour could not be the fill in an appearance, and how much of its
 * chroma the fill has there.
 */
const WHY = ["lightWhy", "darkWhy", "lightChroma", "darkChroma"] as const

/*
 * The signals. `own` says which families have a colour of the consumer's,
 * `fields` holds what is written in every field, in the shape of the recipe:
 * LO-TEK's own value until another is written, where LO-TEK has one.
 * `recipe` is what was chosen and only that, as the text of the recipe file,
 * and `built` is the core's answer to it: the theme, what is wrong with
 * each field, in the shape of `fields`, and what became of each colour.
 * `shown` is the theme the frames have, the last one that was built, and
 * `view` which page they frame. `copied` is the recipe the clipboard last
 * took and `notCopied` the one it last refused. `pasted` is the text in the
 * field a recipe can be pasted into, and `pasteError` why it was not taken.
 * `failed` says the core never came.
 *
 * A signal an action answers into always has the same keys, and only text,
 * numbers and booleans at its leaves. Datastar merges what is assigned into
 * what is there, and an answer that gains a key, loses one or holds a list
 * is a change every time: the effect that assigned it then runs again, for
 * ever. So the recipe is kept as text, and `built` has every key from the
 * start.
 */
const signals = {
  ready: false,
  failed: false,
  own: Object.fromEntries(families.map(([name]) => [name, false])),
  fields: {
    ...Object.fromEntries(families.map(([name]) => [name, ""])),
    typography: resting("typography", top.typography),
    shape: resting("shape", top.shape),
  },
  recipe: "{}",
  built: {
    ok: false,
    css: "",
    error: "",
    wrong: {
      ...Object.fromEntries(families.map(([name]) => [name, ""])),
      typography: empty(top.typography),
      shape: empty(top.shape),
    },
    report: Object.fromEntries(
      families.map(([name]) => [
        name,
        {
          given: "",
          light: "",
          dark: "",
          ...Object.fromEntries(WHY.map((key) => [key, ""])),
        },
      ]),
    ),
  },
  shown: "",
  view: "sheet",
  copied: "",
  notCopied: "",
  pasted: "",
  pasteError: "",
}

/** The two appearances a theme has, each in a frame of its own. */
const APPEARANCES = ["light", "dark"] as const

/**
 * The command that builds the theme from the recipe file, with the version
 * the page is built with: the page shows what that version makes of the
 * recipe, and a newer or an older one may make something else.
 */
const COMMAND = `npx @lo-tek/interfaces@${pkg.version} theme lotek.theme.json --out=theme.css`

/** LO-TEK's own colour of each family: what a family has until it is given one. */
const OWN = contract.brands as Record<string, string>

/** How the file is taken into use, where a bundler reads the CSS. */
const USE = `@import "@lo-tek/interfaces/tokens.css";
@import "./theme.css";`

const id = (path: string) => `field-${path.replaceAll(".", "-")}`
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<FontPreload />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- The page sits outside Starlight, so the tags for shared links,
		     which Starlight writes on the other pages, are here. -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL("/theme-builder/", Astro.site).href} />
		<meta property="og:locale" content="en" />
		<meta property="og:site_name" content="LO-TEK Interfaces" />
		<meta name="twitter:card" content="summary_large_image" />
		{
			SHARE_IMAGE.map((tag) => {
				const { property, name, content } = metaAttributes(tag)
				return <meta property={property} name={name} content={content} />
			})
		}
		<script type="module" src="/datastar.js" data-datastar is:inline></script>
	</head>
	<body class="profile-grain" data-signals={JSON.stringify(signals)}>
		<a class="lt-skip-link" href="#content">Skip to content</a>

		<div class="builder">
			<Top current="/theme-builder/" />

			<main class="builder__main" id="content" tabindex="-1">
				<noscript>
					<p class="builder__line">
						The builder runs in the browser and needs JavaScript. Without it,
						the generator is on the command line:
						<code>{COMMAND}</code>. See <a class="lt-link" href="/your-own-theme/">Your own theme</a>.
					</p>
				</noscript>
				<p class="builder__line" role="alert" style="display: none" data-show="$failed">
					The generator could not be loaded, so nothing here builds a theme.
					Load the page again, or use the command line, which builds the
					same theme: <code>{COMMAND}</code>
				</p>
				<div class="builder__head">
					<h1 class="builder__name profile-name">Theme builder</h1>
					<p class="builder__line">
						You choose the hue, the font and the corners. The generator sets how
						light each colour is, so every contrast promise holds in the light
						theme and the dark.
						<a class="lt-link" href="/your-own-theme/#who-decides-what">What it decides, and why</a>.
						Nothing leaves this page.
					</p>
					<p class="profile-label">
						Built with @lo-tek/interfaces {pkg.version}
					</p>
				</div>

				<!-- What was chosen becomes the recipe, and the recipe becomes the
				     theme. The core is asked only when it has been loaded. -->
				<div hidden data-effect="$ready && ($recipe = @recipe($own, $fields))"></div>
				<div hidden data-effect="$ready && ($built = @buildTheme($recipe, $own, $fields))"></div>
				<div hidden data-effect="$ready && ($built.ok ? ($shown = $built.css) : $built.error === '' && ($shown = ''))"></div>

				<section class="builder__recipe" aria-labelledby="recipe-title">
					<h2 class="profile-label" id="recipe-title">Recipe</h2>

					<fieldset class="lt-fieldset builder__group">
						<legend class="lt-legend">Colours</legend>
						<p class="builder__note">
							Below each colour you give is what it became in the light theme
							and the dark.
						</p>
						{
							families.map(([name, property]) => (
								<div class="builder__family" role="group" aria-labelledby={`own-${name}-label`}>
									<div class="lt-switch-row">
										<input
											class="lt-switch"
											type="checkbox"
											role="switch"
											id={`own-${name}`}
											name={`own.${name}`}
											data-bind={`own.${name}`}
											data-on:change={`!el.checked && ($fields.${name} = '')`}
/>
<label class="lt-label" id={`own-${name}-label`} for={`own-${name}`}>
											{name}
</label>
<span
											class="builder__changed"
											style="display: none"
											data-show={`$own.${name} || $fields.${name} !== ''`}
>
											Changed
</span>
<button
											class="builder__reset"
											type="button"
											aria-label={`Reset ${name}`}
											style="display: none"
											data-show={`$own.${name} || $fields.${name} !== ''`}
											data-on:click={`$fields.${name} = ''; $own.${name} = false`}
>
											Reset
</button>
									</div>
									<!-- The picker shows LO-TEK's colour of the family until
									     another is given, and picking one gives it: the field
									     holds it and the switch is on. It follows the field
									     only while the field holds a whole colour: a picker
									     takes nothing but #rrggbb, and says so in the console
									     for every key pressed on the way there. -->
									<div class="builder__colour">
										<input
											class="builder__picker"
											type="color"
											aria-label={`Pick the colour of ${name}`}
											value={OWN[name]}
											data-on:input={`$fields.${name} = el.value; $own.${name} = true`}
											data-effect={`/^#[0-9a-f]{6}$/i.test($fields.${name}) ? (el.value = $fields.${name}) : $fields.${name} === '' && (el.value = '${OWN[name]}')`}
										/>
										<input
											class="lt-input"
											type="text"
											id={id(name)}
											name={name}
											aria-label={`The colour of ${name}, as #rrggbb`}
											aria-describedby={`${id(name)}-help ${id(name)}-error`}
											placeholder={OWN[name]}
											autocomplete="off"
											spellcheck="false"
											disabled
											data-bind={`fields.${name}`}
											data-attr:disabled={`!$own.${name}`}
											data-attr:aria-invalid={`$built.wrong.${name} !== '' && 'true'`}
											data-attr:data-state={`$built.wrong.${name} !== '' && 'invalid'`}
										/>
									</div>
									<p
										class="lt-error-text"
										id={`${id(name)}-error`}
										style="display: none"
										data-show={`$built.wrong.${name} !== ''`}
										data-text={`$built.wrong.${name}`}
									/>
									<p class="lt-help-text" id={`${id(name)}-help`}>
										{first(property.description)}
									</p>
									<!-- What became of the colour, shown when the recipe gives
									     the family. The row is in the markup and the answer
									     fills it in: a list in a signal is not something
									     Datastar can be handed. -->
								<div
									class="builder__row"
									data-family={name}
									style="display: none"
									data-show={`$built.report.${name}.given !== ''`}
								>
									
									<p class="builder__swatches">
										{(["given", "light", "dark"] as const).map((key) => (
											<span class="builder__colour-of">
												<span class="profile-label">{key}</span>
												<span
													class="builder__swatch"
													data-attr:style={`'background-color: ' + $built.report.${name}.${key}`}
												/>
												<code data-text={`$built.report.${name}.${key}`} />
											</span>
										))}
									</p>
									<!-- The reason takes room, and is the same every time the
									     colour is looked at: it is there for the asking. It
										     is closed again when it changes, since what was
										     opened was the reason for another colour. -->
									<details
										class="builder__reason"
										style="display: none"
										data-show={WHY.map((key) => `$built.report.${name}.${key} !== ''`).join(" || ")}
										data-effect={`${WHY.map((key) => `$built.report.${name}.${key}`).join(", ")}, (el.open = false)`}
									>
										<summary>The colour was adjusted to fit the theme. Show why</summary>
										{WHY.map((key) => (
											<p
												class="builder__why"
												style="display: none"
												data-show={`$built.report.${name}.${key} !== ''`}
												data-text={`$built.report.${name}.${key}`}
											/>
										))}
									</details>
								</div>
								</div>
							))
						}
					</fieldset>

					{
						[
							{ legend: "Typography", fields: typography },
							{ legend: "Shape", fields: shape },
						].map(({ legend, fields }) => (
							<fieldset class="lt-fieldset builder__group">
								<legend class="lt-legend">{legend}</legend>
								{fields.map(({ path, label, help, range }) => (
									<div class="builder__field">
										<div class="builder__label">
											<label class="lt-label" for={id(path)}>
												{label}
											</label>
											<span
												class="builder__changed"
												style="display: none"
												data-show={`$fields.${path}.trim() !== '${range?.text ?? ""}'`}
											>
												Changed
											</span>
											<button
												class="builder__reset"
												type="button"
												aria-label={`Reset ${label}`}
												style="display: none"
												data-show={`$fields.${path}.trim() !== '${range?.text ?? ""}'`}
												data-on:click={`$fields.${path} = '${range?.text ?? ""}'`}
											>
												Reset
											</button>
										</div>
										{range && (
											<input
												class="builder__slider"
												type="range"
												aria-label={`${label}, on a slider`}
												min={range.min}
												max={range.max}
												step={range.step}
												value={range.rest}
												data-on:input={`$fields.${path} = el.value + '${range.unit}'`}
												data-effect={follows(path, range)}
											/>
										)}
										<input
											class="lt-input"
											type="text"
											id={id(path)}
											name={path}
											aria-describedby={`${id(path)}-help ${id(path)}-error`}
											placeholder={range?.none}
											autocomplete="off"
											spellcheck="false"
											data-bind={`fields.${path}`}
											data-attr:aria-invalid={`$built.wrong.${path} !== '' && 'true'`}
											data-attr:data-state={`$built.wrong.${path} !== '' && 'invalid'`}
										/>
										<p
											class="lt-error-text"
											id={`${id(path)}-error`}
											style="display: none"
											data-show={`$built.wrong.${path} !== ''`}
											data-text={`$built.wrong.${path}`}
										/>
										<p class="lt-help-text" id={`${id(path)}-help`}>
											{below(help)}
										</p>
									</div>
								))}
							</fieldset>
						))
					}
				</section>

				<div class="builder__side">
				<section class="builder__preview" aria-labelledby="preview-title">
					<div class="builder__preview-head">
						<h2 class="profile-label" id="preview-title">Preview</h2>
						<fieldset class="lt-toggle-group">
							<legend class="lt-sr-only">What the theme is shown on</legend>
							<label class="lt-toggle-group__option">
								<input type="radio" name="view" value="sheet" checked data-bind="view" />
								Components
							</label>
							<label class="lt-toggle-group__option">
								<input type="radio" name="view" value="page" data-bind="view" />
								Page
							</label>
						</fieldset>
					</div>
					<!-- Each frame holds a whole page, and every control in it is a
					     stop for the keyboard. -->
					<a class="builder__past" href="#out">Skip past the preview, to the recipe as a file</a>
					<p class="builder__note" data-text="$shown === '' ? 'Nothing is set yet, so this is LO-TEK with the colours it comes with.' : $built.ok ? 'LO-TEK with the theme your recipe gives.' : 'The last theme that was built. The recipe as it stands is refused.'">
						Nothing is set yet, so this is LO-TEK with the colours it comes with.
					</p>
					<!-- Each frame is a page of the site with the theme laid on it,
					     the file itself and not a likeness of it. The frame says
					     which appearance it is, and the framed page takes it before
					     it paints. -->
					<div class="builder__frames">
						{
							APPEARANCES.map((appearance) => (
								<figure class="builder__frame">
									<figcaption class="profile-label">{appearance}</figcaption>
									<iframe
										title={`The theme in the ${appearance} appearance`}
										data-appearance={appearance}
										src="/theme-builder/sheet/"
										data-attr:src="'/theme-builder/' + $view + '/'"
										data-effect={`$ready && @showTheme(el, '${appearance}', $shown)`}
										data-on:load={`@showTheme(el, '${appearance}', $shown); @scrollTogether(el)`}
									/>
								</figure>
							))
						}
					</div>
				</section>

				<section class="builder__out" id="out" tabindex="-1" aria-labelledby="out-title">
					<h2 class="profile-label" id="out-title">lotek.theme.json</h2>
					<pre class="builder__json" data-recipe tabindex="0" role="region" aria-label="The recipe, as lotek.theme.json" data-text="$recipe">{"{}"}</pre>
					<!-- What was chosen is remembered in this browser. "Copied" is said
					     of the recipe the clipboard took, once it has taken it, and
					     only while that recipe is the one shown. -->
					<div hidden data-effect="$ready && @remember($own, $fields)"></div>
					<p class="builder__actions">
						<button
							class="lt-button"
							type="button"
							disabled
							data-attr:disabled="!$built.ok"
							data-on:click="const text = $recipe; (navigator.clipboard?.writeText(text) ?? Promise.reject()).then(() => ($copied = text), () => ($notCopied = text))"
						>
							Copy the recipe
						</button>
						<a
							class="lt-button"
							data-variant="secondary"
							download="theme.css"
							style="display: none"
							data-show="$built.ok"
							data-attr:href="$built.ok ? 'data:text/css;charset=utf-8,' + encodeURIComponent($built.css) : ''"
						>
							Download theme.css
						</a>
						<button
							class="lt-button"
							data-variant="ghost"
							type="button"
							data-on:click="@startAgain()"
						>
							Start again
						</button>
						<span class="builder__said" role="status" data-text="$copied === $recipe ? 'Copied.' : $notCopied === $recipe ? 'The browser would not copy it. Select the recipe and copy it by hand.' : ''"></span>
					</p>
					<p class="builder__line">
						Keep the recipe in the repository as <code>lotek.theme.json</code>,
						and build the theme from it. The theme is in a layer of its own, and
						your own CSS beats it: what the recipe does not have,
						<a class="lt-link" href="/customising/#when-the-variable-is-not-enough">you set there</a>.
					</p>
					<pre class="builder__json" tabindex="0" role="region" aria-label="The command that builds the theme"><code>{COMMAND}</code></pre>
					<p class="builder__line">
						Then load <code>theme.css</code> together with LO-TEK's stylesheet,
						and the components have your theme.
						<a class="lt-link" href="/your-own-theme/#using-it">Using it</a>
						shows the same in plain HTML and with Tailwind.
					</p>
					<pre class="builder__json" tabindex="0" role="region" aria-label="How to load the theme"><code>{USE}</code></pre>
				</section>

				<section class="builder__out" aria-labelledby="paste-title">
					<h2 class="profile-label" id="paste-title">A recipe you have</h2>
					<div class="builder__field">
						<label class="lt-label" for="paste">Paste a recipe</label>
						<textarea
							class="lt-textarea"
							id="paste"
							rows="6"
							spellcheck="false"
							aria-describedby="paste-help paste-error"
							data-bind="pasted"
							data-attr:aria-invalid="$pasteError !== '' && 'true'"
							data-attr:data-state="$pasteError !== '' && 'invalid'"></textarea>
						<p
							class="lt-error-text"
							id="paste-error"
							style="display: none"
							data-show="$pasteError !== ''"
							data-text="$pasteError"
						>
						</p>
						<p class="lt-help-text" id="paste-help">
							The text of a <code>lotek.theme.json</code>. It replaces what is chosen above.
						</p>
					</div>
					<p class="builder__actions">
						<button
							class="lt-button"
							data-variant="secondary"
							type="button"
							data-on:click="@useRecipe($pasted)"
						>
							Use this recipe
						</button>
					</p>
				</section>
				</div>
			</main>
		</div>
	</body>
</html>

