---
/**
 * The theme builder: set the keys of a theme recipe, and see what the
 * generator makes of them.
 *
 * The page is written with Datastar. The state is signals, the fields are
 * bound to them, and what is shown is computed from them in the markup. The
 * one thing Datastar cannot do is build the theme: that is the core, in
 * WebAssembly, the same one `lotek theme` runs. The module at the foot loads
 * it and hands Datastar what the markup cannot do itself, as actions through
 * Datastar's own `action()`: the recipe from the fields, the core's answer
 * to it, the theme into a frame, one frame's scrolling to the other, the
 * fields from a recipe that is pasted in, and what was chosen into the
 * browser's storage and out again. Nothing
 * else here is script.
 *
 * The fields are not written by hand. `theme-keys.ts` in the package
 * describes every key of a recipe, and the page has one field for each, so
 * a key the generator gets is a field here the next time the site is built.
 * The schema the editors read is written from the same file, and its tests
 * hold it to the keys the core knows.
 *
 * Everything happens in the browser. The recipe is never sent anywhere, and
 * nothing here is part of what a consumer ships: a theme is a CSS file.
 *
 * The page is always dark, like the front page, and in its profile.
 */

import "@lo-tek/interfaces/lotek.css"
import "../styles/profile.css"
import pkg from "../../../interfaces/package.json" with { type: "json" }
import contract from "../../../interfaces/src/tokens/color-contract.json"
import {
  type Block,
  isBlock,
  type Leaf,
  THEME_KEYS,
} from "../../../interfaces/src/tokens/theme-keys"
import FontPreload from "../components/FontPreload.astro"
import Top from "../components/Top.astro"
import { metaAttributes, SHARE_IMAGE } from "../share-image.mjs"

const title = "Theme builder | LO-TEK Interfaces"
const description =
  "Set your brand colours, font and corners, and see LO-TEK's components with the theme the generator builds from them, in light and dark."

/** The colour families: every key at the top that takes a value. */
const families = Object.entries(THEME_KEYS).filter(
  (entry): entry is [string, Leaf] => !isBlock(entry[1]),
)

/**
 * A slider beside a field whose value is a number: where it starts and
 * ends, and where it rests. `unit` is what is written after the number,
 * and `text` what the field holds at rest, which is nothing where LO-TEK
 * has no one value for the key.
 */
type Range = {
  min: number
  max: number
  step: number
  unit: string
  rest: number
  text: string
}

/**
 * A slider as the page has it: how far it goes, in which unit it writes,
 * and, for a key LO-TEK has no one value for, where it stands until it is
 * moved. That is the page's own: a slider is a way to set a value, not a
 * rule about it.
 */
type Slider = Pick<Range, "min" | "max" | "step" | "unit"> & { stands?: number }

const WEIGHT: Slider = { min: 100, max: 900, step: 100, unit: "" }
const CORNER: Slider = { min: 0, max: 32, step: 1, unit: "px" }
const SLIDERS: [RegExp, Slider][] = [
  [/^typography\.weights\./, WEIGHT],
  [/^typography\.lineHeights\./, { min: 1, max: 2, step: 0.05, unit: "" }],
  [/^shape\.surfaceRadius$/, { ...CORNER, stands: 4 }],
  [/^shape\.\w+Radius$/, CORNER],
  [/^shape\.buttonBorderWidth$/, { min: 0, max: 4, step: 1, unit: "px" }],
  [/^shape\.buttonFontWeight$/, { ...WEIGHT, stands: 500 }],
]

/**
 * A value of the schema as the number a slider shows: a number as it is, a
 * length in pixels. Anything else, a keyword or another unit, cannot stand
 * on a slider, and the build says so rather than drawing one at nothing.
 */
const shown = (path: string, value: string | number) => {
  if (typeof value === "number") return value
  const length = /^(\d*\.?\d+)(px|rem)?$/.exec(value.trim())
  if (!length)
    throw new Error(
      `The default of ${path} in theme-keys.ts is ${JSON.stringify(value)}, which a slider cannot show. Give the key no slider, or teach the page the unit.`,
    )
  return Number(length[1]) * (length[2] === "rem" ? 16 : 1)
}

/**
 * Where a key rests is said where the keys are described, and the schema
 * the editors read says the same: `default` is the value LO-TEK has when
 * the key is left out. A key without one has no one value, and its slider
 * stands where the page has put it.
 */
const rangeOf = (path: string, key: Leaf): Range | undefined => {
  const slider = SLIDERS.find(([at]) => at.test(path))?.[1]
  if (!slider) return undefined
  const { stands, ...range } = slider
  const rest = key.default === undefined ? stands : shown(path, key.default)
  if (rest === undefined)
    throw new Error(
      `${path} has a slider, and theme-keys.ts gives it no default. Say in SLIDERS where the slider stands.`,
    )
  return {
    ...range,
    rest,
    text: key.default === undefined ? "" : String(key.default),
  }
}

/**
 * The slider follows the field: at rest while the field is empty, at the
 * number when the field holds one it can show, and where it was when the
 * field holds something else, `calc(1rem + 2px)` or `bold`.
 */
const follows = (path: string, { rest, unit }: Range) => {
  const field = `$fields.${path}`
  const number = "\\s*\\d*\\.?\\d+"
  if (unit === "")
    return `${field} === '' ? (el.value = ${rest}) : /^${number}\\s*$/.test(${field}) && (el.value = parseFloat(${field}))`
  // A slider says a number, and a screen reader reads it bare. Here it is
  // a length, so the slider says the unit too.
  return `(${field} === '' ? (el.value = ${rest}) : /^(${number}px|\\s*0)\\s*$/i.test(${field}) ? (el.value = parseFloat(${field})) : /^${number}rem\\s*$/i.test(${field}) && (el.value = parseFloat(${field}) * 16)), el.setAttribute('aria-valuetext', el.value + ' ${unit}')`
}

/**
 * Moving the slider writes the field: the number, with its unit. Moved back
 * to where it rests, it writes what the field held at rest, `0.25rem` and
 * not `4px`, so the way back by the slider is a way back.
 */
const moves = (path: string, { rest, unit, text }: Range) =>
  text === ""
    ? `$fields.${path} = el.value + '${unit}'`
    : `$fields.${path} = Number(el.value) === ${rest} ? '${text}' : el.value + '${unit}'`

/**
 * A field of typography or shape. `help` is what the key is for, and
 * `leftOut` what holds while the field is empty, for a key that has no one
 * value to rest at.
 */
type Field = {
  path: string
  label: string
  help: string
  leftOut?: string
  range?: Range
}

/** Every field below a block, with its path: `typography.weights.bold`. */
const fieldsOf = (path: string, block: Block): Field[] =>
  Object.entries(block.keys).flatMap(([name, key]) =>
    isBlock(key)
      ? fieldsOf(`${path}.${name}`, key)
      : [
          {
            path: `${path}.${name}`,
            label: `${path}.${name}`.split(".").slice(1).join(" "),
            help: key.purpose,
            leftOut: key.default === undefined ? key.leftOut : undefined,
            range: rangeOf(`${path}.${name}`, key),
          },
        ],
  )
const typography = fieldsOf("typography", THEME_KEYS.typography as Block)
const shape = fieldsOf("shape", THEME_KEYS.shape as Block)

/**
 * A text at every key of a block, in the shape of the recipe: what the key
 * rests at, LO-TEK's own value where it has one, or nothing at all.
 */
const shaped = (
  block: Block,
  at: "rest" | "nothing",
): Record<string, unknown> =>
  Object.fromEntries(
    Object.entries(block.keys).map(([name, key]) => [
      name,
      isBlock(key)
        ? shaped(key, at)
        : at === "rest" && key.default !== undefined
          ? String(key.default)
          : "",
    ]),
  )
const blocks = (at: "rest" | "nothing") => ({
  typography: shaped(THEME_KEYS.typography as Block, at),
  shape: shaped(THEME_KEYS.shape as Block, at),
})

/**
 * The reasons a row of the report can hold: the core's own sentences about
 * a colour, in its order. It gives at most four, two for each appearance,
 * and a signal cannot hold a list, so a row has four places for them.
 */
const WHY = ["reason1", "reason2", "reason3", "reason4"] as const

/**
 * The places the page has for palettes. The core suggests five, and a
 * signal cannot hold a list, so each has a place in the markup that the
 * answer fills in.
 */
const PLACES = ["p1", "p2", "p3", "p4", "p5"] as const

/*
 * The signals. `own` says which families have a colour of the consumer's,
 * `fields` holds what is written in every field, in the shape of the recipe:
 * LO-TEK's own value until another is written, where LO-TEK has one.
 * `recipe` is what was chosen and only that, as the text of the recipe file,
 * and `built` is the core's answer to it: the theme, what is wrong with
 * each field, in the shape of `fields`, and what became of each colour.
 * `shown` is the theme the frames have, the last one that was built, and
 * `view` which page they frame and `appearances` which of the frames are
 * shown: the dark one alone, both, or the light one alone. `copied` is the recipe the clipboard last
 * took and `notCopied` the one it last refused. `pasted` is the text in the
 * field a recipe can be pasted into, and `pasteError` why it was not taken.
 * `suggested` says which families hold a colour a palette filled in, and
 * not one the visitor wrote or picked, and `palettes` is the core's answer
 * to the recipe without those: the colour the palettes are built on, and
 * each palette in its place. Beside them, `none` has LO-TEK's own colour of
 * each family the palettes have one for, and `stale` says the answer is an
 * earlier one, shown while the accent is no colour. `used` is the name of
 * the palette the suggested colours are from, which they follow when the
 * accent changes. `undo` is what was chosen before "Start again", as text,
 * while it can still be put back.
 * `failed` says the core never came.
 *
 * A signal an action answers into always has the same keys, and only text,
 * numbers and booleans at its leaves. Datastar merges what is assigned into
 * what is there, and an answer that gains a key, loses one or holds a list
 * is a change every time: the effect that assigned it then runs again, for
 * ever. So the recipe is kept as text, and `built` has every key from the
 * start.
 */
const signals = {
  ready: false,
  failed: false,
  own: Object.fromEntries(families.map(([name]) => [name, false])),
  suggested: Object.fromEntries(families.map(([name]) => [name, false])),
  used: "",
  undo: "",
  palettes: {
    from: "",
    stale: false,
    none: Object.fromEntries(families.map(([name]) => [name, ""])),
    ...Object.fromEntries(
      PLACES.map((place) => [
        place,
        {
          name: "",
          description: "",
          colors: Object.fromEntries(
            families.map(([name]) => [name, { color: "", kept: false }]),
          ),
        },
      ]),
    ),
  },
  fields: {
    ...Object.fromEntries(families.map(([name]) => [name, ""])),
    ...blocks("rest"),
  },
  recipe: "{}",
  built: {
    ok: false,
    css: "",
    error: "",
    wrong: {
      ...Object.fromEntries(families.map(([name]) => [name, ""])),
      ...blocks("nothing"),
    },
    report: Object.fromEntries(
      families.map(([name]) => [
        name,
        {
          given: "",
          light: "",
          dark: "",
          ...Object.fromEntries(WHY.map((key) => [key, ""])),
        },
      ]),
    ),
  },
  shown: "",
  view: "sheet",
  appearances: "dark",
  copied: "",
  notCopied: "",
  pasted: "",
  pasteError: "",
}

/** The two appearances a theme has, each in a frame of its own. */
const APPEARANCES = ["dark", "light"] as const

/**
 * The command that builds the theme from the recipe file, with the version
 * the page is built with: the page shows what that version makes of the
 * recipe, and a newer or an older one may make something else.
 */
const COMMAND = `npx @lo-tek/interfaces@${pkg.version} theme lotek.theme.json --out=theme.css`

/** LO-TEK's own colour of each family: what a family has until it is given one. */
const OWN = contract.brands as Record<string, string>

/** How the file is taken into use, where a bundler reads the CSS. */
const USE = `@import "@lo-tek/interfaces/tokens.css";
@import "./theme.css";`

const id = (path: string) => `field-${path.replaceAll(".", "-")}`

/** Whether any family holds a suggestion, and whether a palette is in use. */
const anySuggested = `(${families.map(([name]) => `$suggested.${name}`).join(" || ")})`
const inUse = (place: string) =>
  `$used !== '' && $used === $palettes.${place}.name && ${anySuggested}`
/** What the palette in use says of itself, and nothing when none is. */
const says = `${PLACES.map((place) => `${inUse(place)} ? $palettes.${place}.description : `).join("")}''`
/** A dot of a strip: the colour as paint, and out of the way without one. */
const dot = (color: string) =>
  `${color} !== '' ? 'background-color: ' + ${color} : 'display: none'`
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<FontPreload />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- The page sits outside Starlight, so the tags for shared links,
		     which Starlight writes on the other pages, are here. -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL("/theme-builder/", Astro.site).href} />
		<meta property="og:locale" content="en" />
		<meta property="og:site_name" content="LO-TEK Interfaces" />
		<meta name="twitter:card" content="summary_large_image" />
		{
			SHARE_IMAGE.map((tag) => {
				const { property, name, content } = metaAttributes(tag)
				return <meta property={property} name={name} content={content} />
			})
		}
		<script type="module" src="/datastar.js" data-datastar is:inline></script>
	</head>
	<body class="profile-grain" data-signals={JSON.stringify(signals)}>
		<a class="lt-skip-link" href="#content">Skip to content</a>

		<div class="builder">
			<Top current="/theme-builder/" />

			<main class="builder__main" id="content" tabindex="-1">
				<noscript>
					<p class="builder__line">
						The builder runs in the browser and needs JavaScript. Without it,
						the generator is on the command line:
						<code>{COMMAND}</code>. See <a class="lt-link" href="/your-own-theme/">Your own theme</a>.
					</p>
				</noscript>
				<div class="builder__head">
					<h1 class="builder__name profile-name">Theme builder</h1>
					<p class="builder__line">
						You choose the hue, the font and the corners. The generator sets how
						light each colour is, so every contrast promise holds in the light
						theme and the dark.
						<a class="lt-link" href="/your-own-theme/#who-decides-what">What it decides, and why</a>.
						Nothing leaves this page.
					</p>
					<p class="profile-label">
						Built with @lo-tek/interfaces {pkg.version}
					</p>
					<!-- In the head, so the page is laid out the same with it as
					     without: the generator did not come. -->
					<p class="builder__line" role="alert" style="display: none" data-show="$failed">
						The generator could not be loaded, so nothing here builds a theme.
						Load the page again, or use the command line, which builds the
						same theme: <code>{COMMAND}</code>
					</p>
				</div>

				<!-- What was chosen becomes the recipe, and the recipe becomes the
				     theme. The core is asked only when it has been loaded. -->
				<div hidden data-effect="$ready && ($recipe = @recipe($own, $fields))"></div>
				<div hidden data-effect="$ready && ($built = @buildTheme($recipe, $own))"></div>
				<div hidden data-effect="$ready && ($palettes = @suggestPalettes($recipe, $suggested))"></div>
				<div hidden data-effect="$ready && $used !== '' && @followPalette($palettes, $suggested, $used)"></div>
				<div hidden data-effect="$ready && ($built.ok ? ($shown = $built.css) : $built.error === '' && ($shown = ''))"></div>

				<section class="builder__recipe" aria-labelledby="recipe-title">
					<h2 class="profile-label" id="recipe-title">Recipe</h2>

					<fieldset class="lt-fieldset builder__group">
						<legend class="lt-legend">Colours</legend>
						<p class="builder__note">
							Below each colour you give is what it became in the light theme
							and the dark.
						</p>
						{
							families.map(([name, key]) => (
								<div class="builder__family" role="group" aria-labelledby={`own-${name}-label`}>
									<div class="lt-switch-row">
										<input
											class="lt-switch"
											type="checkbox"
											role="switch"
											id={`own-${name}`}
											name={`own.${name}`}
											data-bind={`own.${name}`}
											data-on:change={`!el.checked && ($fields.${name} = '', $suggested.${name} = false)`}
/>
<label class="lt-label" id={`own-${name}-label`} for={`own-${name}`}>
											{name}
</label>
<span
											class="builder__changed"
											style="display: none"
											data-show={`$own.${name} && $fields.${name} !== ''`}
											>
												Changed
</span>
<button
											class="builder__reset"
											type="button"
											aria-label={`Reset ${name}`}
											style="display: none"
											data-show={`$own.${name} || $fields.${name} !== ''`}
											data-on:click={`$fields.${name} = ''; $own.${name} = false; $suggested.${name} = false; document.getElementById('own-${name}').focus()`}
>
											Reset
</button>
									</div>
									<!-- The picker shows LO-TEK's colour of the family until
									     another is given, and picking one gives it: the field
									     holds it and the switch is on. It follows the colour
									     as the core read it, and not the field: the core
									     takes #f0a and F7DF1E, and a picker takes nothing
									     but #rrggbb, and says so in the console for anything
									     else. The field is not bound with data-bind: what is
									     written is the visitor's own before it is a value, so
									     the family stops being a suggestion first, and the
									     palette in use does not write its colour back. -->
									<div class="builder__colour">
										<input
											class="builder__picker"
											type="color"
											aria-label={`Pick the colour of ${name}`}
											value={OWN[name]}
											data-on:input={`$fields.${name} = el.value; $own.${name} = true; $suggested.${name} = false`}
											data-effect={`$built.report.${name}.given !== '' ? (el.value = $built.report.${name}.given) : $fields.${name} === '' && (el.value = '${OWN[name]}')`}
										/>
										<input
											class="lt-input"
											type="text"
											id={id(name)}
											name={name}
											aria-label={`The colour of ${name}, as #rrggbb`}
											aria-describedby={`${id(name)}-help ${id(name)}-error`}
											placeholder={OWN[name]}
											autocomplete="off"
											spellcheck="false"
											disabled
											data-on:input={`$suggested.${name} = false; $fields.${name} = el.value`}
											data-effect={`el.value !== $fields.${name} && (el.value = $fields.${name})`}
											data-attr:disabled={`!$own.${name}`}
											data-attr:aria-invalid={`$built.wrong.${name} !== '' && 'true'`}
											data-attr:data-state={`$built.wrong.${name} !== '' && 'invalid'`}
										/>
									</div>
									<p
										class="lt-error-text"
										id={`${id(name)}-error`}
										style="display: none"
										data-show={`$built.wrong.${name} !== ''`}
										data-text={`$built.wrong.${name}`}
									/>
									<p class="lt-help-text" id={`${id(name)}-help`}>
										{key.purpose}
									</p>
									<!-- What became of the colour, shown when the recipe gives
									     the family. The row is in the markup and the answer
									     fills it in: a list in a signal is not something
									     Datastar can be handed. -->
								<div
									class="builder__row"
									data-family={name}
									style="display: none"
									data-show={`$built.report.${name}.given !== ''`}
								>
									
									<p class="builder__swatches">
										{(["given", "light", "dark"] as const).map((key) => (
											<span class="builder__colour-of">
												<span class="profile-label">{key}</span>
												<span
													class="builder__swatch"
													data-attr:style={`'background-color: ' + $built.report.${name}.${key}`}
												/>
												<code data-text={`$built.report.${name}.${key}`} />
											</span>
										))}
									</p>
									<!-- The reason takes room, and is the same every time the
									     colour is looked at: it is there for the asking. It
										     is closed again when it changes, since what was
										     opened was the reason for another colour. -->
									<details
										class="builder__reason"
										style="display: none"
										data-show={WHY.map((key) => `$built.report.${name}.${key} !== ''`).join(" || ")}
										data-effect={`${WHY.map((key) => `$built.report.${name}.${key}`).join(", ")}, (el.open = false)`}
									>
										<summary>The colour was adjusted to fit the theme. Show why</summary>
										{WHY.map((key) => (
											<p
												class="builder__why"
												style="display: none"
												data-show={`$built.report.${name}.${key} !== ''`}
												data-text={`$built.report.${name}.${key}`}
											/>
										))}
									</details>
								</div>
								{
									name === "accent" && (
										<details class="lt-accordion builder__palettes" data-variant="plain" open style="display: none" data-show="$palettes.from !== ''">
											<!-- The palettes the core suggests, each a strip to press:
											     its name and its colours as paint. The one in use is
											     pressed and says so, and LO-TEK's own, last, takes
											     the suggestions away. While the accent is no colour
											     the strips stand as they were and cannot be pressed.
											     They can be folded away, and are open until they are. -->
											<summary>Palette</summary>
											<div class="lt-accordion__content builder__palettes-content">
											<div class="builder__strips" role="group" aria-label="Palette" data-palettes>
												{PLACES.map((place) => (
													<button
														class="builder__strip"
														type="button"
														data-palette
														style="display: none"
														data-show={`$palettes.${place}.name !== ''`}
														data-attr:disabled="$palettes.stale"
														data-attr:aria-pressed={`${inUse(place)} ? 'true' : 'false'`}
														data-on:click={`@usePalette($palettes.${place})`}
													>
														<span data-text={`$palettes.${place}.name`} />
														<span class="builder__dots">
															{families.map(([family]) => (
																<span
																	class="builder__dot"
																	data-family={family}
																	style="display: none"
																	data-attr:data-kept={`$palettes.${place}.colors.${family}.kept ? 'true' : 'false'`}
																	data-attr:data-color={`$palettes.${place}.colors.${family}.color`}
																	data-attr:style={dot(`$palettes.${place}.colors.${family}.color`)}
																/>
															))}
														</span>
														<span class="builder__changed" style="display: none" data-show={inUse(place)}>
															In use
														</span>
													</button>
												))}
												<button
													class="builder__strip"
													type="button"
													data-palette-default
													data-attr:aria-pressed={`${PLACES.map((place) => `!(${inUse(place)})`).join(" && ")} ? 'true' : 'false'`}
													data-on:click="@noPalette($suggested)"
												>
													<span>LO-TEK</span>
													<span class="builder__dots">
														{families.map(([family]) => (
															<span
																class="builder__dot"
																data-family={family}
																style="display: none"
																data-attr:data-color={`$palettes.none.${family}`}
																data-attr:style={dot(`$palettes.none.${family}`)}
															/>
														))}
													</span>
												</button>
											</div>
											<p class="builder__why" data-palette-says style="display: none" data-show={`(${says}) !== ''`} data-text={says} />
											</div>
										</details>
									)
								}
								</div>
							))
						}
					</fieldset>

					{
						[
							{ legend: "Typography", fields: typography },
							{ legend: "Shape", fields: shape },
						].map(({ legend, fields }) => (
							<fieldset class="lt-fieldset builder__group">
								<legend class="lt-legend">{legend}</legend>
								{fields.map(({ path, label, help, leftOut, range }) => (
									<div class="builder__field">
										<div class="builder__label">
											<label class="lt-label" for={id(path)}>
												{label}
											</label>
											<span
												class="builder__changed"
												style="display: none"
												data-show={`$fields.${path} !== '' && $fields.${path} !== '${range?.text ?? ""}'`}
												>
													Changed
											</span>
											<button
												class="builder__reset"
												type="button"
												aria-label={`Reset ${label}`}
												style="display: none"
												data-show={`$fields.${path} !== '${range?.text ?? ""}'`}
												data-on:click={`$fields.${path} = '${range?.text ?? ""}'; document.getElementById('${id(path)}').focus()`}
											>
												Reset
											</button>
										</div>
										{range && (
											<input
												class="builder__slider"
												type="range"
												aria-label={`${label}, on a slider`}
												min={range.min}
												max={range.max}
												step={range.step}
												value={range.rest}
												data-on:input={moves(path, range)}
												data-effect={follows(path, range)}
											/>
										)}
										<input
											class="lt-input"
											type="text"
											id={id(path)}
											name={path}
											aria-describedby={`${id(path)}-help ${id(path)}-error`}
											autocomplete="off"
											spellcheck="false"
											data-bind={`fields.${path}`}
											data-attr:aria-invalid={`$built.wrong.${path} !== '' && 'true'`}
											data-attr:data-state={`$built.wrong.${path} !== '' && 'invalid'`}
										/>
										<p
											class="lt-error-text"
											id={`${id(path)}-error`}
											style="display: none"
											data-show={`$built.wrong.${path} !== ''`}
											data-text={`$built.wrong.${path}`}
										/>
										<p class="lt-help-text" id={`${id(path)}-help`}>
											{help}
											{leftOut && ` ${leftOut}`}
										</p>
									</div>
								))}
							</fieldset>
						))
					}
				</section>

				<div class="builder__side">
				<section class="builder__preview" aria-labelledby="preview-title">
					<div class="builder__preview-head">
						<h2 class="profile-label" id="preview-title">Preview</h2>
						<!-- "Start again" empties everything, and is then the way
						     back, until something is chosen again. -->
						<div class="builder__preview-tools">
							<div hidden data-effect="$undo !== '' && @recipe($own, $fields) !== '{}' && ($undo = '')"></div>
							<button
								class="lt-button"
								data-variant="secondary"
								type="button"
								data-on:click="$undo !== '' ? @undoStartAgain($undo) : @startAgain($own, $fields, $suggested, $used)"
								data-text="$undo !== '' ? 'Undo' : 'Start again'"
							>
								Start again
							</button>
						<!-- One appearance alone has the width of both. Which is
						     shown is about the visitor and not the recipe, so
						     "Start again" leaves it. -->
						<div hidden data-effect="$ready && (@rememberAppearances($appearances), @keepPlace())"></div>
						<fieldset class="lt-toggle-group">
							<legend class="lt-sr-only">Which appearances are shown</legend>
							<label class="lt-toggle-group__option">
								<input type="radio" name="appearances" value="dark" checked data-bind="appearances" />
								Dark
							</label>
							<label class="lt-toggle-group__option">
								<input type="radio" name="appearances" value="both" data-bind="appearances" />
								Both
							</label>
							<label class="lt-toggle-group__option">
								<input type="radio" name="appearances" value="light" data-bind="appearances" />
								Light
							</label>
						</fieldset>
						<fieldset class="lt-toggle-group">
							<legend class="lt-sr-only">What the theme is shown on</legend>
							<label class="lt-toggle-group__option">
								<input type="radio" name="view" value="sheet" checked data-bind="view" />
								Components
							</label>
							<label class="lt-toggle-group__option">
								<input type="radio" name="view" value="page" data-bind="view" />
								Page
							</label>
						</fieldset>
						</div>
					</div>
					<!-- Each frame holds a whole page, and every control in it is a
					     stop for the keyboard. -->
					<a class="builder__past" href="#out">Skip past the preview, to the recipe as a file</a>
					<p class="builder__note" data-text="$shown === '' ? 'Nothing is set yet, so this is LO-TEK with the colours it comes with.' : $built.ok ? 'LO-TEK with the theme your recipe gives.' : 'The last theme that was built. The recipe as it stands is refused.'">
						Nothing is set yet, so this is LO-TEK with the colours it comes with.
					</p>
					<!-- Each frame is a page of the site with the theme laid on it,
					     the file itself and not a likeness of it. The frame says
					     which appearance it is, and the framed page takes it before
					     it paints. -->
					<div class="builder__frames">
						{
							APPEARANCES.map((appearance) => (
								<figure
									class="builder__frame"
									data-show={`$appearances === 'both' || $appearances === '${appearance}'`}
								>
									<figcaption class="profile-label">{appearance}</figcaption>
									<iframe
										title={`The theme in the ${appearance} appearance`}
										data-appearance={appearance}
										src="/theme-builder/sheet/"
										data-attr:src="'/theme-builder/' + $view + '/'"
										data-effect={`$ready && @showTheme(el, '${appearance}', $shown)`}
										data-on:load={`@showTheme(el, '${appearance}', $shown); @scrollTogether(el)`}
									/>
								</figure>
							))
						}
					</div>
				</section>

				<section class="builder__out" id="out" tabindex="-1" aria-labelledby="out-title">
					<h2 class="profile-label" id="out-title">lotek.theme.json</h2>
					<pre class="builder__json" data-recipe tabindex="0" role="region" aria-label="The recipe, as lotek.theme.json" data-text="$recipe">{"{}"}</pre>
					<!-- What was chosen is remembered in this browser. "Copied" is said
					     of the recipe the clipboard took, once it has taken it, and
					     only while that recipe is the one shown. -->
					<div hidden data-effect="$ready && @remember($own, $fields, $suggested, $used)"></div>
					<p class="builder__actions">
						<button
							class="lt-button"
							type="button"
							disabled
							data-attr:disabled="!$built.ok"
							data-on:click="const text = $recipe; (navigator.clipboard?.writeText(text) ?? Promise.reject()).then(() => ($copied = text), () => ($notCopied = text))"
						>
							Copy the recipe
						</button>
						<a
							class="lt-button"
							data-variant="secondary"
							download="theme.css"
							style="display: none"
							data-show="$built.ok"
							data-attr:href="$built.ok ? 'data:text/css;charset=utf-8,' + encodeURIComponent($built.css) : ''"
						>
							Download theme.css
						</a>
						<span class="builder__said" role="status" data-text="$copied === $recipe ? 'Copied.' : $notCopied === $recipe ? 'The browser would not copy it. Select the recipe and copy it by hand.' : ''"></span>
					</p>
					<p class="builder__line">
						Keep the recipe in the repository as <code>lotek.theme.json</code>,
						and build the theme from it. The theme is in a layer of its own, and
						your own CSS beats it: what the recipe does not have,
						<a class="lt-link" href="/customising/#when-the-variable-is-not-enough">you set there</a>.
					</p>
					<pre class="builder__json" tabindex="0" role="region" aria-label="The command that builds the theme"><code>{COMMAND}</code></pre>
					<p class="builder__line">
						Then load <code>theme.css</code> together with LO-TEK's stylesheet,
						and the components have your theme.
						<a class="lt-link" href="/your-own-theme/#using-it">Using it</a>
						shows the same in plain HTML and with Tailwind.
					</p>
					<pre class="builder__json" tabindex="0" role="region" aria-label="How to load the theme"><code>{USE}</code></pre>
				</section>

				<section class="builder__out" aria-labelledby="paste-title">
					<h2 class="profile-label" id="paste-title">A recipe you have</h2>
					<div class="builder__field">
						<label class="lt-label" for="paste">Paste a recipe</label>
						<textarea
							class="lt-textarea"
							id="paste"
							rows="6"
							spellcheck="false"
							aria-describedby="paste-help paste-error"
							data-bind="pasted"
							data-attr:aria-invalid="$pasteError !== '' && 'true'"
							data-attr:data-state="$pasteError !== '' && 'invalid'"></textarea>
						<p
							class="lt-error-text"
							id="paste-error"
							style="display: none"
							data-show="$pasteError !== ''"
							data-text="$pasteError"
						>
						</p>
						<p class="lt-help-text" id="paste-help">
							The text of a <code>lotek.theme.json</code>. It replaces what is chosen above.
						</p>
					</div>
					<p class="builder__actions">
						<button
							class="lt-button"
							data-variant="secondary"
							type="button"
							data-on:click="@useRecipe($pasted)"
						>
							Use this recipe
						</button>
					</p>
				</section>
				</div>
			</main>
		</div>
	</body>
</html>

<style is:global>
	/*
	 * The page is a printed sheet, as the front page is, and in the same
	 * profile. The colours come from tokens, and the only thing written in is
	 * the geometry.
	 */
	html {
		background: var(--lt-color-neutral-canvas);
		-webkit-text-size-adjust: 100%;
	}

	body {
		min-block-size: 100dvh;
		margin: 0;
		/* On the body as well as on html: the grain blends inside the body's
		   isolated group, and a transparent body would leave it nothing to
		   blend with. */
		background: var(--lt-color-neutral-canvas);
		color: var(--lt-color-neutral-text);
		font-family: var(--profile-font-data);
		font-size: var(--lt-font-size-s);
		line-height: var(--lt-line-height-default);
	}

	code {
		font-family: var(--profile-font-data);
	}

	.builder {
		max-inline-size: 104rem;
		margin-inline: auto;
		padding: var(--lt-spacing-5) var(--lt-spacing-5) var(--lt-spacing-12);
	}

	@media (min-width: 48rem) {
		.builder {
			padding: var(--lt-spacing-8) var(--lt-spacing-10) var(--lt-spacing-16);
		}
	}

	.builder__main {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--lt-spacing-8);
		align-items: start;
		padding-block-start: var(--lt-spacing-8);
	}

	.builder__main:focus {
		outline: none;
	}

	/* The preview and what follows it are placed by the page's own grid. */
	.builder__side {
		display: contents;
	}

	/* The recipe beside what it gives, when there is room for both. The
	   preview has the right column to itself and stays in view while the
	   left one, which is long, is scrolled: the recipe, and below it the
	   file and the field to paste one into. Were anything below the preview
	   in its column, the preview would stay and lie over it. */
	@media (min-width: 72rem) {
		.builder__main {
			grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
		}

		.builder__main > * {
			grid-column: 1 / -1;
		}

		.builder__recipe,
		.builder__out {
			grid-column: 1;
		}

		/* Beside the recipe the frames have the height of the window, less
		   what stands above them in the preview: its head, the line that
		   says what is shown and the caption of a frame. */
		.builder__preview .builder__frame iframe {
			block-size: max(24rem, calc(100dvh - 11rem));
		}

		.builder__preview {
			grid-column: 2;
			grid-row: 2 / span 3;
			align-self: start;
			position: sticky;
			inset-block-start: var(--lt-spacing-4);
		}
	}

	.builder__head {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-3);
	}

	.builder__name {
		margin: 0;
		font-size: clamp(var(--lt-font-size-xl), 5vw, var(--lt-font-size-mega));
		color: var(--lt-color-neutral-text-strong);
	}

	.builder__line,
	.builder__note {
		margin: 0;
		max-inline-size: 44rem;
		text-wrap: pretty;
	}

	/* The introduction has the width of the page to itself, and takes more
	   of it than a line further down does. */
	.builder__head .builder__line {
		max-inline-size: 72rem;
	}

	.builder__recipe,
	.builder__out,
	.builder__group,
	.builder__preview {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-4);
		min-inline-size: 0;
	}

	/* A group of the recipe: a plate's worth of fields under a rule. */
	.builder__group {
		margin: 0;
		padding: var(--lt-spacing-4) 0 0;
		border: 0;
		border-block-start: var(--profile-rule);
	}

	.builder__group > legend {
		padding: 0;
		font-family: var(--profile-font-name);
		font-size: var(--lt-font-size-m);
		font-weight: 400;
		text-transform: uppercase;
		color: var(--lt-color-neutral-text-strong);
	}

	.builder__family,
	.builder__field {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-1);
	}

	.builder__family {
		padding-block-end: var(--lt-spacing-3);
		border-block-end: var(--profile-rule-subtle);
	}

	.builder__colour {
		display: flex;
		gap: var(--lt-spacing-2);
	}

	/* The name of a field, and beside it that it is changed and the way back. */
	.builder__label {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--lt-spacing-1) var(--lt-spacing-3);
	}
	
	/* What stopped a paste can be several things, each on a line of its own. */
	#paste-error {
		white-space: pre-line;
	}

	.builder__changed {
		font-size: var(--lt-font-size-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--lt-color-warning-text);
	}
	
	.builder__changed::before {
		content: "● ";
	}
	
	.builder__reset {
		/* Small beside a label, and still large enough to hit. */
		min-inline-size: 24px;
		min-block-size: 24px;
		margin: 0;
		padding: 0 var(--lt-spacing-1);
		border: 0;
		background: none;
		font: inherit;
		font-size: var(--lt-font-size-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--lt-color-accent-text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		cursor: pointer;
	}
	
	.builder__reset:hover {
		color: var(--lt-color-neutral-text-strong);
	}
	
	.builder__reset:focus-visible {
		outline: var(--lt-focus-ring, 2px solid var(--lt-color-accent-fill));
		outline-offset: var(--lt-spacing-1);
	}
	
	.builder__family .lt-switch-row {
		flex-wrap: wrap;
		align-items: center;
		gap: var(--lt-spacing-1) var(--lt-spacing-3);
	}
	
	.builder__slider {
		inline-size: 100%;
		margin: 0;
		accent-color: var(--lt-color-accent-fill);
	}
	
	.builder__picker {
		flex: none;
		inline-size: var(--lt-spacing-10);
		block-size: auto;
		padding: 0;
		border: var(--profile-rule);
		background: none;
	}

	/* What became of a colour: the three swatches, and why. */
	.builder__row {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-2);
		padding-block-start: var(--lt-spacing-2);
	}

	.builder__row > p {
		margin: 0;
	}

	.builder__swatches {
		display: flex;
		flex-wrap: wrap;
		gap: var(--lt-spacing-2) var(--lt-spacing-5);
	}

	.builder__colour-of {
		display: inline-flex;
		align-items: center;
		gap: var(--lt-spacing-2);
	}

	.builder__swatch {
		display: inline-block;
		inline-size: var(--lt-spacing-6);
		block-size: var(--lt-spacing-6);
		border: var(--profile-rule);
	}

	.builder__reason > summary {
		font-size: var(--lt-font-size-xs);
		color: var(--lt-color-neutral-text);
		cursor: pointer;
	}
	
	.builder__reason > summary:hover {
		color: var(--lt-color-neutral-text-strong);
	}
	
	.builder__reason > summary:focus-visible {
		outline: var(--lt-focus-ring, 2px solid var(--lt-color-accent-fill));
		outline-offset: var(--lt-spacing-1);
	}
	
	.builder__reason > p {
		margin: var(--lt-spacing-2) 0 0;
	}
	
	.builder__why {
		font-size: var(--lt-font-size-xs);
		line-height: var(--lt-line-height-article);
		text-wrap: pretty;
	}

	/* The palettes the core suggests, under the accent: a strip each. */
	/* An accordion of LO-TEK, with the page behind it. Its summary keeps
	   room at the sides, less than LO-TEK's own: the hover and the focus
	   ring are drawn to its edge, and with none they lie on the text and
	   the chevron. The content has none, so the strips are as wide as the
	   fields around them. */
	.builder__palettes {
		--lt-accordion-padding-inline: var(--lt-spacing-2);
		margin-block-start: var(--lt-spacing-3);
		/* The family it stands in ends with a rule of its own. */
		border-block-end: 0;
		background: none;
	}

	.builder__palettes > .lt-accordion__content {
		padding-inline: 0;
	}

	.builder__palettes-content {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-2);
	}

	.builder__palettes-content > p {
		margin: 0;
	}

	.builder__strips {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(6.9rem, 1fr));
		gap: var(--lt-spacing-2);
	}

	.builder__strip {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-2);
		padding: var(--lt-spacing-2) var(--lt-spacing-3);
		border: var(--profile-rule);
		background: none;
		color: inherit;
		font: inherit;
		font-size: var(--lt-font-size-s);
		text-align: start;
		cursor: pointer;
	}

	.builder__strip:hover {
		background: var(--lt-color-neutral-surface);
	}

	.builder__strip:focus-visible {
		outline: var(--lt-focus-ring, 2px solid var(--lt-color-accent-fill));
		outline-offset: 2px;
	}

	.builder__strip[aria-pressed="true"] {
		outline: 2px solid var(--lt-color-accent-fill);
		outline-offset: -2px;
		font-weight: var(--lt-font-weight-semibold);
	}

	.builder__strip:disabled {
		opacity: 0.5;
		cursor: default;
	}

	.builder__strip .builder__changed {
		font-weight: var(--lt-font-weight-regular);
	}

	.builder__dots {
		display: flex;
		gap: 3px;
	}

	.builder__dot {
		inline-size: 1.1rem;
		block-size: 1.1rem;
		border: var(--profile-rule-subtle);
	}

	.builder__preview-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--lt-spacing-3);
	}

	.builder__preview-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--lt-spacing-4);
	}

	/* The way past the frames is for the keyboard: out of sight until it has
	   focus, and then where it stands, above the frames it leads past. The
	   skip link of the package cannot be used here, since it hides above the
	   top of the window and this one is far down the page. */
	.builder__past:not(:focus) {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.builder__past:focus {
		align-self: start;
		padding: var(--lt-spacing-2) var(--lt-spacing-3);
		background: var(--lt-color-neutral-text-strong);
		color: var(--lt-color-neutral-canvas);
		outline: var(--lt-focus-ring, 2px solid var(--lt-color-accent-fill));
		outline-offset: 2px;
	}

	.builder__frames {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
		gap: var(--lt-spacing-4);
	}

	.builder__frame {
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-2);
		min-inline-size: 0;
		margin: 0;
	}

	.builder__frame iframe {
		display: block;
		inline-size: 100%;
		block-size: min(44rem, 72dvh);
		border: var(--profile-rule);
	}

	.builder__json {
		margin: 0;
		padding: var(--lt-spacing-4);
		overflow: auto;
		border: var(--profile-rule);
		font-family: var(--profile-font-data);
		font-size: var(--lt-font-size-s);
		line-height: var(--lt-line-height-default);
		color: var(--lt-color-neutral-text-strong);
	}

	.builder__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--lt-spacing-3);
		margin: 0;
	}

	.builder__said {
		font-size: var(--lt-font-size-s);
	}

	/* The buttons are square on this page, as on the front page. */
	.builder {
		--lt-button-radius: 0;
		--lt-input-radius: 0;
		--lt-textarea-radius: 0;
	}
</style>

<script>
	import contract from "@lo-tek/interfaces/color-contract.json?raw"
	import wasm from "@lo-tek/interfaces/core.wasm?url"
	import { loadCore } from "@lo-tek/interfaces/diagnostics"

	/*
	 * The module: the core, and what else the markup cannot do, handed to
	 * Datastar as actions.
	 *
	 * Datastar is taken from the address the page loaded it from, so this is
	 * the same instance the markup runs on, and not a second copy bundled in
	 * here. `action()` is Datastar's own way to add an action, shown in its
	 * "custom plugin" example and not promised to stay as it is:
	 * `datastar-extension.browser.test.ts` says so when it changes.
	 */
	const address = document.querySelector<HTMLScriptElement>(
		"script[data-datastar]",
	)?.src
	const { action, mergePatch } = await import(/* @vite-ignore */ address ?? "")

	// The core may not come: the file is large, and a network can drop it.
	// Then the page says so, and is never told it is ready.
	let loaded: ReturnType<typeof loadCore> | undefined
	try {
		const file = await fetch(wasm)
		if (!file.ok) throw new Error(`${file.status}`)
		loaded = loadCore(await WebAssembly.compile(await file.arrayBuffer()))
		loaded.loadContract(contract)
	} catch {
		mergePatch({ failed: true })
	}
	// The actions that ask the core run only when the page is ready, and it
	// is ready only with a core.
	const core = loaded as ReturnType<typeof loadCore>

	type Fields = { [key: string]: string | Fields }

	/** A palette in its place: a colour for every family, or none. */
	type Place = {
		name: string
		description: string
		colors: Record<string, { color: string; kept: boolean }>
	}

	/*
	 * The page as on a first visit: what the markup itself says the signals
	 * are. It is the shape of `own` and `fields`, and what every field holds
	 * at rest: what is not in the recipe, what a pasted recipe leaves a field
	 * it does not name at, and what "Start again" goes back to.
	 */
	const first = JSON.parse(document.body.getAttribute("data-signals") ?? "{}") as {
		own: Record<string, boolean>
		suggested: Record<string, boolean>
		palettes: { p1: Place; none: Record<string, string> } & Record<string, unknown>
		fields: Fields
	}

	/**
	 * The fields that hold something other than they do at rest, in the
	 * shape they have. Nothing when none does.
	 */
	const filled = (fields: Fields, rest: Fields): Fields | undefined => {
		const kept: Fields = {}
		for (const [name, value] of Object.entries(fields)) {
			const own =
				typeof value === "string" ? value : filled(value, rest[name] as Fields)
			if (own !== undefined && own !== "" && own !== rest[name]) kept[name] = own
		}
		return Object.keys(kept).length > 0 ? kept : undefined
	}

	// What was chosen, and only that: a family when its switch is on and its
	// field has a value, a key of typography or shape when its field holds
	// something other than LO-TEK's own value.
	action({
		name: "recipe",
		apply(_: unknown, own: Record<string, boolean>, fields: Fields) {
			const chosen: Fields = {}
			for (const [name, value] of Object.entries(fields)) {
				if (typeof value !== "string") continue
				if (own[name] && value !== "") chosen[name] = value
			}
			return JSON.stringify(
				{
					...chosen,
					...filled({ typography: fields.typography, shape: fields.shape }, first.fields),
				},
				null,
				2,
			)
		},
	})

	type Row = Record<string, string>

	type Problem = { path: string[]; kind: string; message: string }
	type Value = { path: string[]; text: string }

	/** Whether two paths are the same key. */
	const same = (a: string[], b: string[]) =>
		a.length === b.length && a.every((segment, at) => segment === b[at])

	/** The problem with a value at `path`, when the core refuses it. */
	const refusedAt = (problems: Problem[], path: string[]) =>
		problems.find((p) => p.kind === "refused" && same(p.path, path))

	/**
	 * What the core finds wrong, laid at the fields: the reason at every
	 * field whose value the core refuses, and nothing at the others, in the
	 * shape of `blank`.
	 */
	const atFields = (blank: Fields, problems: Problem[], at: string[] = []): Fields =>
		Object.fromEntries(
			Object.entries(blank).map(([name, value]) => [
				name,
				typeof value === "string"
					? (refusedAt(problems, [...at, name])?.message ?? "")
					: atFields(value, problems, [...at, name]),
			]),
		)

	/**
	 * What a recipe gives, laid at the fields: the core's text at every field
	 * the recipe has a value for, and what the field holds at rest at the
	 * others, in the shape of `blank`.
	 */
	const placed = (blank: Fields, values: Value[], at: string[] = []): Fields =>
		Object.fromEntries(
			Object.entries(blank).map(([name, value]) => [
				name,
				typeof value === "string"
					? (values.find((v) => same(v.path, [...at, name]))?.text ?? value)
					: placed(value, values, [...at, name]),
			]),
		)

	type Says = { family: string; given: string; light: { fill: string }; dark: { fill: string }; reasons: string[] }

	/** The rows of the report: what became of each colour, and the core's sentences in their places. */
	const rows = (brands: Says[]): Record<string, Row> =>
		Object.fromEntries(
			brands.map((brand) => {
				const [reason1 = "", reason2 = "", reason3 = "", reason4 = ""] = brand.reasons
				return [
					brand.family,
					{ given: brand.given, light: brand.light.fill, dark: brand.dark.fill, reason1, reason2, reason3, reason4 },
				]
			}),
		)

	// The core's answer to a recipe: the theme, what is wrong with each
	// field, and what became of each colour. A recipe with nothing in it is
	// not a mistake, only nothing yet. Every answer has the same keys; see
	// the note at the signals.
	action({
		name: "buildTheme",
		apply(_: unknown, recipe: string, own: Record<string, boolean>) {
			const families = Object.keys(own)
			const noRow = { given: "", light: "", dark: "", reason1: "", reason2: "", reason3: "", reason4: "" }
			const empty = Object.fromEntries(families.map((name) => [name, { ...noRow }]))
			const chosen = JSON.parse(recipe)
			// The core says what is wrong with every key at once, and the
			// page lays each reason at its field.
			const problems: Problem[] = core.checkRecipe(chosen)
			const wrong = atFields(first.fields, problems)
			// Nothing is chosen yet. The core calls that an empty theme, and
			// here it is no mistake.
			if (problems.some((p) => p.kind === "empty"))
				return { ok: false, css: "", error: "", wrong, report: empty }
			// What became of each colour is the core's to say, also while
			// something else in the recipe is refused: a colour that is put
			// right says what it becomes at once.
			const report = { ...empty, ...rows(core.recipeBrands(chosen)) }
			if (problems.length > 0)
				return { ok: false, css: "", error: problems[0].message, wrong, report }
			return { ok: true, css: core.buildTheme(chosen).css, error: "", wrong, report }
		},
	})

	type Answer = {
		from: string
		palettes: { name: string; description: string; colors: { family: string; color: string; kept: boolean }[] }[]
	}

	/** LO-TEK's own colour of each family, from the contract the core has. */
	const ownColours = JSON.parse(contract).brands as Record<string, string>

	/** A place with no palette in it, as text. */
	const emptyPlace = JSON.stringify(first.palettes.p1)

	/** The palettes as the signal holds them, from an answer of the core. */
	const laidOut = (answer: Answer) => {
		// A place of its own each time: what is handed to Datastar becomes
		// the signal's, and two places must not share a colour.
		const blank = (): Place => JSON.parse(emptyPlace)
		const places = Object.keys(first.palettes).filter((key) => /^p\d+$/.test(key))
		// The families the palettes have a colour for, with LO-TEK's own.
		const suggestedFor = new Set(answer.palettes.flatMap((p) => p.colors.map((c) => c.family)))
		return {
			from: answer.from,
			stale: false,
			none: Object.fromEntries(
				Object.keys(first.palettes.none).map((family) => [
					family,
					suggestedFor.has(family) ? (ownColours[family] ?? "") : "",
				]),
			),
			...Object.fromEntries(
				places.map((place, at) => {
					const palette = answer.palettes[at]
					if (!palette) return [place, blank()]
					const colors = blank().colors
					for (const { family, color, kept } of palette.colors)
						if (family in colors) colors[family] = { color, kept }
					return [place, { name: palette.name, description: palette.description, colors }]
				}),
			),
		}
	}

	// The core's palettes for what the visitor chose: the recipe without the
	// families a palette filled in, so the palettes stay what they were after
	// one is taken. With no answer, while the accent is no colour, the last
	// one stands and says it is stale, so nothing moves while a colour is
	// written; before any answer every place is empty.
	// The last answer is kept as text: what an action hands Datastar becomes
	// the signal's own, and must not be handed over twice.
	let lastPalettes: string | undefined
	action({
		name: "suggestPalettes",
		apply(_: unknown, recipe: string, suggested: Record<string, boolean>) {
			const chosen = JSON.parse(recipe)
			for (const [family, is] of Object.entries(suggested)) if (is) delete chosen[family]
			const answer: Answer | null = core.suggestPalettes(chosen)
			if (answer) lastPalettes = JSON.stringify(laidOut(answer))
			if (!lastPalettes) return laidOut({ from: "", palettes: [] })
			return { ...JSON.parse(lastPalettes), stale: !answer }
		},
	})

	// A palette into the fields: every colour the core suggests, and none it
	// says is the recipe's own. The families are remembered as suggested, so
	// the next palette can take their place.
	action({
		name: "usePalette",
		apply(_: unknown, palette: Place) {
			const filled = Object.entries(palette.colors).filter(
				([, { color, kept }]) => color !== "" && !kept,
			)
			mergePatch({
				own: Object.fromEntries(filled.map(([family]) => [family, true])),
				suggested: Object.fromEntries(filled.map(([family]) => [family, true])),
				fields: Object.fromEntries(filled.map(([family, { color }]) => [family, color])),
				used: palette.name,
			})
		},
	})

	// LO-TEK's own again: every family that holds a suggestion is emptied and
	// switched off, and no palette is in use. A colour the visitor wrote is
	// no suggestion, and stands.
	action({
		name: "noPalette",
		apply(_: unknown, suggested: Record<string, boolean>) {
			const emptied = Object.keys(suggested).filter((family) => suggested[family])
			mergePatch({
				own: Object.fromEntries(emptied.map((family) => [family, false])),
				suggested: Object.fromEntries(emptied.map((family) => [family, false])),
				fields: Object.fromEntries(emptied.map((family) => [family, ""])),
				used: "",
			})
		},
	})

	// The suggested colours follow their palette: when the core's answer
	// changes, with the accent or a status, each family that still holds a
	// suggestion gets the colour the palette in use now has for it. A colour
	// the visitor wrote, and a family that was emptied, is no suggestion and
	// is left alone. With no answer the colours stand.
	action({
		name: "followPalette",
		apply(_: unknown, palettes: Record<string, unknown>, suggested: Record<string, boolean>, used: string) {
			// Only the places are asked for a name: to read a key a signal
			// does not have is to give it one, and an answer without that
			// key is then a change every time.
			const palette = Object.entries(palettes)
				.filter(([key]) => /^p\d+$/.test(key))
				.map(([, place]) => place as Place)
				.find((place) => place.name === used)
			if (!palette) return
			const follows = Object.entries(palette.colors).filter(
				([family, { color, kept }]) => suggested[family] && color !== "" && !kept,
			)
			if (follows.length > 0)
				mergePatch({
					fields: Object.fromEntries(follows.map(([family, { color }]) => [family, color])),
				})
		},
	})

	/*
	 * The theme of a frame: the appearance on `<html>`, and the CSS in one
	 * `<style>` in `<head>`, the file as the generator writes it. An empty
	 * theme empties the element, and the page shows LO-TEK's own colours.
	 * The frame asks when the theme changes and when it has loaded a page.
	 */
	action({
		name: "showTheme",
		apply(_: unknown, frame: HTMLIFrameElement, appearance: string, css: string) {
			const page = frame.contentDocument
			// Before the page has come, or between two pages.
			if (!page?.head || page.location.href === "about:blank") return
			page.documentElement.dataset.theme = appearance
			page.documentElement.style.colorScheme = appearance
			let style = page.head.querySelector<HTMLStyleElement>("style[data-theme-builder]")
			if (!style) {
				if (css === "") return
				style = page.createElement("style")
				style.setAttribute("data-theme-builder", "")
				page.head.append(style)
			}
			if (style.textContent !== css) style.textContent = css
		},
	})

	// The two frames show the same page, and are read side by side: scrolling
	// one scrolls the other to the same place. A frame that is already there
	// is left alone, which is what stops the two from answering each other.
	// Where the frames are, as the element at the top of the one last
	// scrolled and how far into it the top is. A frame that is hidden has no
	// height and forgets where it was, and one that gets another width lays
	// its page out again, so a number of pixels would not be the same place.
	let place: { path: number[]; into: number } | null = null
	// While the frames are put back, their own scrolling says nothing.
	let placing = false

	const frames = () => [...document.querySelectorAll<HTMLIFrameElement>("iframe[data-appearance]")]
	const pageOf = (frame: HTMLIFrameElement) => {
		const root = frame.contentDocument?.documentElement
		return root && root.clientHeight > 0 ? root : null
	}

	const notePlace = (root: HTMLElement) => {
		const doc = root.ownerDocument
		const at = doc.elementFromPoint(root.clientWidth / 2, 1)
		if (!at || !doc.body.contains(at)) return
		const path: number[] = []
		for (let el: Element = at; el !== doc.body && el.parentElement; el = el.parentElement)
			path.unshift([...el.parentElement.children].indexOf(el))
		const box = at.getBoundingClientRect()
		place = { path, into: box.height > 0 ? -box.top / box.height : 0 }
	}

	const toPlace = (root: HTMLElement) => {
		if (!place) return
		let el: Element | undefined = root.ownerDocument.body
		for (const index of place.path) el = el?.children[index]
		if (!el) return
		const box = el.getBoundingClientRect()
		const top = root.scrollTop + box.top + place.into * box.height
		root.ownerDocument.defaultView?.scrollTo({ top, behavior: "instant" })
	}

	action({
		name: "scrollTogether",
		apply(_: unknown, frame: HTMLIFrameElement) {
			frame.contentWindow?.addEventListener(
				"scroll",
				() => {
					const from = pageOf(frame)
					if (placing || !from) return
					notePlace(from)
					const part = from.scrollTop / Math.max(1, from.scrollHeight - from.clientHeight)
					for (const other of frames()) {
						const to = pageOf(other)
						if (other === frame || !to) continue
						const top = part * (to.scrollHeight - to.clientHeight)
						if (Math.abs(to.scrollTop - top) > 1.5)
							other.contentWindow?.scrollTo({ top, behavior: "instant" })
					}
				},
				{ passive: true },
			)
		},
	})

	// Another choice of frames shows the same place in those that are shown,
	// once they have their new width.
	action({
		name: "keepPlace",
		apply() {
			placing = true
			requestAnimationFrame(() =>
				requestAnimationFrame(() => {
					for (const frame of frames()) {
						const root = pageOf(frame)
						if (root) toPlace(root)
					}
					requestAnimationFrame(() => {
						placing = false
					})
				}),
			)
		},
	})

	const REMEMBERED = "lotek-theme-builder"

	/**
	 * The values of `from` laid into the shape of `blank`, as text. A field
	 * `from` does not name, or gives something else than a value, is as in
	 * `blank`.
	 */
	const laid = (blank: Fields, from: unknown): Fields =>
		Object.fromEntries(
			Object.entries(blank).map(([name, value]) => {
				const given = (from as Record<string, unknown> | null)?.[name]
				if (typeof value !== "string") return [name, laid(value, given)]
				return [
					name,
					typeof given === "string" || typeof given === "number" ? String(given) : value,
				]
			}),
		)

	// What is chosen is kept in this browser and nowhere else. Storage can be
	// switched off, and then the page works without remembering.
	action({
		name: "remember",
		apply(_: unknown, own: Record<string, boolean>, fields: Fields, suggested: Record<string, boolean>, used: string) {
			try {
				localStorage.setItem(REMEMBERED, JSON.stringify({ own, fields, suggested, used }))
			} catch {
				// Nothing to do: the page is as useful, only not next time.
			}
		},
	})

	// Which appearances are shown is kept by itself: it is not of the recipe.
	const SHOWN = "lotek-theme-builder-appearances"
	action({
		name: "rememberAppearances",
		apply(_: unknown, appearances: string) {
			try {
				localStorage.setItem(SHOWN, appearances)
			} catch {
				// As for the recipe: the page works without remembering.
			}
		},
	})

	// Everything as on a first visit. What was chosen is kept as text for as
	// long as it can be put back: until something is chosen again. Nothing
	// chosen, nothing to put back.
	action({
		name: "startAgain",
		apply(_: unknown, own: Record<string, boolean>, fields: Fields, suggested: Record<string, boolean>, used: string) {
			const nothing = JSON.stringify({ own: first.own, fields: first.fields })
			// The empty page is what is then remembered: the effect that
			// remembers runs on this as on any change.
			mergePatch({
				own: first.own,
				suggested: first.suggested,
				used: "",
				fields: first.fields,
				pasted: "",
				pasteError: "",
				undo: JSON.stringify({ own, fields }) === nothing ? "" : JSON.stringify({ own, fields, suggested, used }),
			})
		},
	})

	action({
		name: "undoStartAgain",
		apply(_: unknown, undo: string) {
			const before = JSON.parse(undo)
			mergePatch({ ...before, undo: "" })
		},
	})

	// A recipe file pasted in becomes what is chosen. Text that is not JSON
	// changes nothing, and the page says so itself: that is about the field.
	// Everything about the recipe is the core's to say.
	action({
		name: "useRecipe",
		apply(_: unknown, text: string) {
			const refuse = (pasteError: string) => mergePatch({ pasteError })
			let recipe: unknown
			try {
				recipe = JSON.parse(text)
			} catch {
				return refuse("This is not JSON. Paste the text of a lotek.theme.json.")
			}
			// The core reads the recipe: what it gives, and what is wrong
			// with it. A text the core refuses does not stop a paste: a
			// field can hold it, and says what is wrong with it. Anything
			// else does, an empty recipe too, and then nothing changes and
			// the core's own words about what stopped it are shown.
			const problems: Problem[] = core.checkRecipe(recipe)
			const values: Value[] = core.recipeValues(recipe)
			const given = (path: string[]) => values.some((v) => same(v.path, path))
			const stops = problems.filter((p) => !(p.kind === "refused" && given(p.path)))
			if (stops.length > 0) return refuse(stops.map((p) => p.message).join("\n"))
			mergePatch({
				own: Object.fromEntries(
					Object.keys(first.own).map((name) => [name, given([name])]),
				),
				// A pasted recipe is the visitor's own, every colour of it.
				suggested: first.suggested,
				used: "",
				fields: placed(first.fields, values),
				pasteError: "",
			})
		},
	})

	// The families the core suggests colours for, and what its palettes are
	// called: those of a recipe that gives nothing.
	const offered: Answer["palettes"] = loaded?.suggestPalettes({})?.palettes ?? []
	const suggestable = new Set(offered.flatMap((palette) => palette.colors.map((color) => color.family)))
	const named = new Set(offered.map((palette) => palette.name))

	// What was left the last time, before Datastar is told the core is here.
	try {
		const kept = JSON.parse(localStorage.getItem(REMEMBERED) ?? "null")
		if (kept)
			mergePatch({
				own: Object.fromEntries(
					Object.keys(first.own).map((name) => [name, kept.own?.[name] === true]),
				),
				// Only a family that is switched on can hold a suggestion, and
				// only one the core suggests colours for: what is remembered
				// may be from another version, or not the page's own writing.
				suggested: Object.fromEntries(
					Object.keys(first.suggested).map((name) => [
						name,
						kept.suggested?.[name] === true && kept.own?.[name] === true && suggestable.has(name),
					]),
				),
				used: typeof kept.used === "string" && named.has(kept.used) ? kept.used : "",
				fields: laid(first.fields, kept.fields),
			})
	} catch {
		// Nothing remembered that can be read. The page starts empty.
	}

	try {
		const appearances = localStorage.getItem(SHOWN)
		if (appearances === "light" || appearances === "both") mergePatch({ appearances })
	} catch {
		// Nothing remembered: the dark one is shown.
	}

	if (loaded) mergePatch({ ready: true })
</script>
