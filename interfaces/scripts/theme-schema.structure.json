{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lo-tek.sobernetics.no/theme.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "accent": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "visited": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "brand1": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "brand2": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "brand3": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "neutral": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "danger": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "warning": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "success": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "type": "string"
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regular": {
              "type": ["string", "number"]
            },
            "medium": {
              "type": ["string", "number"]
            },
            "semibold": {
              "type": ["string", "number"]
            },
            "bold": {
              "type": ["string", "number"]
            }
          }
        },
        "lineHeights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": ["string", "number"]
            },
            "article": {
              "type": ["string", "number"]
            },
            "compact": {
              "type": ["string", "number"]
            }
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buttonRadius": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "const": 0
            }
          ]
        },
        "fieldRadius": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "const": 0
            }
          ]
        },
        "surfaceRadius": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "const": 0
            }
          ]
        },
        "buttonBorderWidth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "const": 0
            }
          ]
        },
        "buttonFontWeight": {
          "type": ["string", "number"]
        }
      }
    }
  }
}
